# Generated playtest traces, captures, exports and local source snapshots.
# Keep these on disk; reproducible source harnesses are tracked separately.
/patch-notes/design-logs/
**/__pycache__/
*.pyc

# Import caches and scratch work stay local, including isolated simulator copies.
**/.godot/
**/.codex-godot-temp/
# Disposable test profiles and rebuilt Windows exports are not source artifacts.
/docs/**/APPDATA/
/docs/**/LOCALAPPDATA/
/docs/**/profiles/
/docs/**/export-smoke-*/
/docs/**/*.exe
/docs/**/*.pck
