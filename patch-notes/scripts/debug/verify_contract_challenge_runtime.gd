extends "res://scripts/debug/verify_sidestreet_contract.gd"

func _verify() -> void:
	snapshots.load_ledgers()
	database = root.get_node("CardDatabase")
	var equal := {0:14,1:14,2:14,3:14}
	var side_terms := ContractChallenges.terms_for_contract(ContractDefinitions.SIDESTREET)
	check(ContractChallenges.terms_for_contract(ContractDefinitions.IRONCLAD).is_empty(), "Ironclad has no challenge")
	check(ContractChallenges.reward(side_terms,12,equal,0) == {"grade_bp":10000,"cash_cents":10000,"promotion":4}, "Full SideStreet reward is $100 and 4 Promotion")
	check(ContractChallenges.reward(side_terms,14,equal,0) == {"grade_bp":5000,"cash_cents":5000,"promotion":2}, "Scope penalty gives half reward")
	check(ContractChallenges.reward(side_terms,12,equal,1) == {"grade_bp":0,"cash_cents":0,"promotion":0}, "Successful redraw loses SideStreet reward")
	var crown := ContractChallenges.reward(ContractChallenges.terms_for_contract(ContractDefinitions.CROWN),12,{0:22,1:12,2:12,3:12},0)
	check(crown == {"grade_bp":2500,"cash_cents":2500,"promotion":1}, "Dominant Core gives graded Crown reward")
	var neon := ContractChallenges.reward(ContractChallenges.terms_for_contract(ContractDefinitions.NEON),20,{0:12,1:12,2:12,3:12},0)
	check(neon == {"grade_bp":8000,"cash_cents":8000,"promotion":3}, "Insufficient Core:Scope ratio gives graded Neon reward")
	var star := ContractChallenges.reward(ContractChallenges.terms_for_contract(ContractDefinitions.STARWAVE),12,{0:12,1:14,2:14,3:14},0)
	check(star == {"grade_bp":8750,"cash_cents":8750,"promotion":3}, "Below-target Starwave score gives graded reward")
	check(ContractChallenges.reward(ContractChallenges.terms_for_contract(ContractDefinitions.STARWAVE),12,{0:16,1:14,2:14,3:14},0) == star, "Starwave over-target penalty is symmetric")
	var run := new_run(200000)
	var game := release(0)
	check(run.register_release(game), "Legal release opens first Contract entitlement")
	var iron := await complete_contract(run,run.accept_primitive_contract())
	check(iron.phase != null and run.get_pending_promotion() == 0, "Ironclad completion preserves zero challenge Promotion")
	(iron.phase as ContractPhase).queue_free()
	var side_offer := run.get_next_sidestreet_offer()
	var side_state := run.accept_sidestreet_offer(side_offer.offer_id)
	check(side_state != null and side_state.get_challenge_terms() == side_terms, "SideStreet terms freeze on acceptance")
	var side := await complete_contract(run,side_state)
	var result := side_state.get_result()
	var base := side_state.calculate_for_state(result.get_scope(),result._core_half_units)
	check(result.get_bonus_cash_cents()==10000 and result.get_bonus_promotion()==4, "Final hand awards full separate SideStreet bonus")
	check(result.get_payout_cents()==int(base.payout_cents)+10000 and result.get_promotion()==4, "Challenge adds to, never reduces, base payout")
	check((side.phase as ContractPhase)._completion_stats.text.contains("Challenge grade") and (side.phase as ContractPhase)._completion_stats.text.contains("$100.00"), "Completion view separates challenge grade and bonus")
	check(run.get_pending_promotion()==4, "Bonus Promotion banks for next successful launch")
	(side.phase as ContractPhase).queue_free()
	var redraw_run := new_run(200000)
	var redraw_game := release(0)
	redraw_run.register_release(redraw_game)
	var redraw_iron := await complete_contract(redraw_run,redraw_run.accept_primitive_contract())
	(redraw_iron.phase as ContractPhase).queue_free()
	var redraw_offer := redraw_run.get_next_sidestreet_offer()
	var redraw_state := redraw_run.accept_sidestreet_offer(redraw_offer.offer_id)
	var session: Variant = load("res://scripts/simulation/contract_session.gd").new(redraw_state,redraw_run,database.get_development_catalog())
	session.publish_initial(fixture_cards(true))
	var before_rng := redraw_run.random_streams.snapshot()
	var before_budget := redraw_run.get_available_redraws()
	var invalid_slots: Array[int] = [99]
	check(not session.redraw(invalid_slots).ok and redraw_state.get_challenge_redraws()==0 and before_rng==redraw_run.random_streams.snapshot() and before_budget==redraw_run.get_available_redraws(), "Rejected redraw preserves grade inputs, budget and RNG")
	var pass_slot: Array[int] = [1]
	var rolls: Array[float] = [0.0]
	var redrawn: Dictionary = session.redraw(pass_slot,rolls,rolls)
	check(redrawn.ok and redraw_state.get_challenge_redraws()==1 and redraw_run.get_available_redraws()==before_budget-1, "Successful Contract redraw records one challenge miss")
	var cards: Array[CardData] = []
	for id in ContractState.PASS_IDS: cards.append(database.get_card(id))
	for i in range(2):
		var plan := redraw_state.plan_hand(cards)
		var commit := func() -> bool: return redraw_run.commit_contract_hand(redraw_state,cards,plan.remainder_cents)
		check(redraw_run.complete_productive_action(commit,plan.remainder_cents,redraw_run.get_completed_run_cycles(),&"",&"publisher_receipt" if plan.remainder_cents>0 else &"contract_hand",redraw_state.get_offer_id()), "No-redraw miss still completes base Contract")
	var missed := redraw_state.get_result()
	var missed_base := redraw_state.calculate_for_state(missed.get_scope(),missed._core_half_units)
	check(missed.get_bonus_cash_cents()==0 and missed.get_bonus_promotion()==0 and missed.get_payout_cents()==missed_base.payout_cents, "Miss loses only the separate bonus")
	print("Contract challenge runtime: %d failures" % failures)
	quit(0 if failures==0 else 1)
