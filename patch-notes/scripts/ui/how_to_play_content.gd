class_name HowToPlayContent
extends RefCounted

## Player reference for current runtime rules, independent of run/save state.
## Keep this alongside presentation code: help edits are not content migrations.
static func sections() -> Array:
	return [
		_section("start", "Start Here", "Your first studio, from an idea to a release.", [
			_page("loop", "The game loop", "Build games. Learn from each release. Grow your studio.", "[b]1 · Set up[/b]\nName your Studio, choose a permanent Genre specialty and review optional Traits. New Studios use the fixed Public Action Engine: 17 Features, 27 maximum Scope, no upfront fee and a 30% royalty on post-platform Studio sales.\n\n[b]2 · Develop[/b]\nName a project, choose its Genre, Theme and engine, then begin Design. Design and Alpha build Core quality and Scope; Beta searches for Bugs, fixes them and builds Marketing. An ordinary hand can contain one to four cards. Four-card hands are needed for hand synergies.\n\n[b]3 · Release and return[/b]\nInspect the frozen launch results. Later productive actions advance sales, bills and eight rival Studios. In Studio, browse reports, implement Features in your own engines, consider Contracts and plan the next game."),
			_page("specialty", "Genre specialty & starting engine", "Your specialty and your selected project engine are separate choices.", "Choose one permanent Studio Genre specialty during creation. It does not restrict the Genre of future projects.\n\nEvery new Studio starts with Public Action access, regardless of specialty. Its fixed 17-Feature library has 27 maximum Scope, no upfront fee and a 30% royalty on post-platform Studio sales. It is public access rather than an owned engine: its library is read only, with no player upgrades or Skill Tree.\n\nEach project's Genre sets its Core Review standards. The chosen engine supplies its eligible Feature pool and freezes its capacity when the project begins. Studio Management → Engines lets you inspect public and rival terms or create your own engine. Existing saves retain their saved access and historical terms."),
			_page("setup", "Setup folders", "Review Genre Specializations, Traits and Overview before creating the Studio.", "Use the folders to review your permanent Genre specialty, optional Traits and starting finances. An attention mark identifies a folder needing review. Visiting Traits clears its visit reminder even when you choose none.\n\nNew Studios use the same fixed Public Action Engine. The preview identifies that actual library; choosing a specialty does not grant an owned engine or extra Feature cards.\n\nChanging a choice after Overview requires another review. The final Trait balance must be valid. Back preserves the draft; Discard setup asks before clearing it. An existing saved Studio is replaced only after the new Studio is successfully created and saved."),
			_page("first_game", "First game checklist", "Watch Core percentages, engine capacity, Pass Budget and the next bill.", "Feature cards add printed Core and Scope; Passes add Core without Scope. The normal project requirement is 30 Scope. Public Action's capacity is 27, so a project using it remains below that requirement even when its engine capacity is filled.\n\nUse one to four cards for an ordinary hand. Four matching cards can specialize; a qualifying four-card Feature hand can earn Balanced Production. Short hands still spend an ordinary productive cycle.\n\nDesign and Alpha each have an independent Pass Budget. New projects start each phase with 10 allowance and earn one more per eight cumulative printed Feature Core in that phase. Keep cash for paid Feature plays and bills.\n\nAlpha Playtest adds two protected corrective Passes immediately for no cash and one cycle. Beta Playtest costs $500 and one cycle. Before launch, inspect Scope, remaining Bugs and Marketing."),
		]),
		_section("studio", "Studio", "The home of your studio's long-term decisions.", [
			_page("hub", "Studio Phase", "Four groups organize reports, management, market information and production.", "[b]Studio Info[/b] contains Studio Info, Post Game Summaries and Bank. Summaries include Detailed Review and Monthly Sales.\n\n[b]Studio Management[/b] contains Employees and Engines. Feature Implementation and Skill Tree open from an owned proprietary engine's details. The global Studio Store button is retired.\n\n[b]Market Info[/b] contains the market browser, Rival Info and Publisher List. [b]Start Production[/b] contains Produce Game/Produce Next Game and Contracts. Locked actions keep their existing requirements.\n\nBrowsing and Back are free. Begin, implementation completion, Search and other productive actions use the shared calendar. Successful Studio entry restores the redraw bank to four; reopening a menu does not grant another refill."),
			_page("project", "Start a project", "Choose the name, Genre, Theme and engine before the pool is frozen.", "The name, Genre and Theme stay with the project. Genre sets Core Review standards; Theme identifies it for market comparisons without a direct scoring bonus.\n\nChoose an accessible engine in setup. Selection updates the Studio default immediately, even if you cancel the form. Begin freezes that engine's capacity and current future-project Feature supply. Later implementations, licenses and Skill milestones do not rewrite the active project.\n\nEditing and Back are free. Successful Begin costs one productive calendar cycle, starts project cycle zero and restores four redraws. If a required Studio save is pending, Begin waits for its durable boundary and rechecks the current setup.\n\nEach project has fresh finite Feature usage and separate Design/Alpha Pass Budgets. Availability in an engine does not guarantee a particular draw."),
			_page("traits", "Studio Traits", "Choose any affordable combination; keep the final point balance valid.", "New Studios start with four Trait points. There is no fixed limit of two positives and one negative. Choose each Trait at most once and keep the final balance nonnegative. Choosing none is valid. Each unspent point adds $50 to starting cash. Choose only one education history: Graduate or College Dropout.\n\n[b]Family Funding · 2 points[/b]\nAdds $300 separate startup funding.\n\n[b]Cult Following · 1 point, trial[/b]\nStarts with 20 ordinary Fans once; normal gains and losses apply.\n\n[b]Publisher Connections · 1 point[/b]\nFirst Ironclad advance $550; remaining pool $1,850. Full payout stays $2,400.\n\n[b]Resourceful · 1 point[/b]\nUp to $100 off the first paid Feature acquisition per release window. For queued work, the saving applies to the final balance, not the down payment.\n\n[b]Lean Production · 2 points[/b]\n10% off paid Primitive hands, capped at $100 per project.\n\n[b]Studio Buzz · 1 point[/b]\nAdds 3 Awareness on each launch.\n\n[b]College Dropout · grants 2 points[/b]\n$5,000 education debt; no cash deposit. Twelve months' grace, then 95 payments of $70.68 and a final $71.11.\n\n[b]Graduate · grants 6 points[/b]\n$20,000 education debt; no cash deposit. Twelve months' grace, then 95 payments of $282.73 and a final $283.28.\n\n[b]Expensive Lease · grants 2 points[/b]\nAdds $15 monthly rent. New Studios pay $315 rather than $300; existing saves keep their actual saved rate.\n\n[b]Unknown Name · grants 2 points[/b]\nSubtracts 10 Awareness from the first successful launch, floored at zero.\n\nCheck Overview before confirming. Existing Studios retain their saved Trait version and issued obligations."),
			_page("employees", "Hire an employee", "Production, QA and Project Manager become available after two releases.", "Open Studio Management → Employees after completing two game releases. The current system offers one Production Specialist, one QA Specialist and one Project Manager. Each hire costs $100, spends no productive cycle and requires affordable cash, current bills and a valid quote.\n\nA new hire starts at $1,000 per in-game month. The first payday follows the first full month after hiring; inspect the next bill. Existing issued bills and saved historical wages remain intact.\n\nRoster, Courses and Progress are separate folders. Course enrollment costs $150 and no productive cycle. Enrollment starts a challenge; it does not immediately grant its benefit. Each completed course adds a prospective $100/month raise without rewriting issued bills.\n\nProduction has two sequential courses, Project Manager has four, and QA has Search & Fix and QA Versatility. Read the challenge and payroll before committing."),
			_page("training", "Courses & employee training", "Enroll first; later committed play earns the benefit and raise.", "[b]Production[/b]\nProduction Planning completes after enrollment with a Design hand containing a Core Pass and a Feature matching its printed primary or secondary Core. A later matching Design/Alpha hand can bundle one changed priority plan per project without a separate change cycle. The training hand cannot spend its new benefit.\n\nPass Alignment is the second course. After enrollment, make a printed Pass/Feature match in both Design and Alpha of one game, then successfully release it. Its benefit lets an eligible ordinary Pass be replaced by a chosen Core Pass matching a visible Feature, using one normal redraw. Cancel is free; protected Playtest Passes cannot be replaced.\n\n[b]Project Manager[/b]\nEach sequential course requires four distinct released games, each with two actual four-card Specializations played at the category's then-legal minimum priority. Design, Alpha and eligible Beta Specializations count; Contracts do not. Each course widens both priority bounds by five. Core ranges progress from 20–40 to 0–60; held-Insider Beta progresses from 40–60 to 20–80.\n\n[b]QA[/b]\nSearch & Fix requires a later Beta hand that actually discovers a Hidden Bug and fixes a Known Bug. Its trial benefit gives qualifying Feature specialization replays a 25% chance each to discover a real Hidden Bug. QA Versatility counts three pure four-Search and three pure four-Debug Beta hands across projects; zero-output hands count. Its benefit lets a later pure hand arm one Swap for a later hand that project.\n\nOnly post-enrollment committed actions count. Enrollment alone grants neither the benefit nor its $100/month completion raise."),
			_page("history", "Release history & Annual Awards", "Reports preserve actual results; awards freeze once each year.", "Studio Info → Post Game Summaries holds release history. Choose a title, then inspect its frozen Detailed Review and Monthly Sales. Eligible titles expose Run Campaign with its actual quote.\n\nThe market browser lists live player/AI releases and separately labels Historical records. Historical units are unavailable, not invented. Your Studio excludes historical rival rows. Rival Info shows the eight live rival Studios.\n\nAnnual Game Awards settle at the committed December Week 2 cutoff. Seven categories use released Core, earned Fans, total Fans or Review as appropriate; Game of the Year uses Review. Each nomination grants 10 Fans. Each win adds 40 Fans and 5 Awareness banked for that Studio's next successful launch. Rankings and rewards never reroll when viewed.\n\nThe first ceremony is mandatory. Later presentations may be skipped through their controls or Settings without changing rewards. Each page waits for its durable save. Reading reports never repeats payouts or advances productive time."),
		]),
		_section("development", "Development", "Choose hands, manage costs and guide a project through release.", [
			_page("phases", "Design → Alpha → Beta", "Each phase asks a different question.", "[b]Design:[/b] implement Features and build the project's foundation.\n\n[b]Alpha:[/b] expand production, improve Core scores and test the game. Production generates Bug Pressure that affects later bug work.\n\n[b]Beta:[/b] Search, Debug and Marketing prepare the release. Insider work is temporarily disabled. Phase changes are not extra production hands.\n\nChoose when to move forward. More hands can improve a game but also use money and calendar time."),
			_page("priorities", "Category priorities", "Priorities change future draws; earned Manager courses widen their ranges.", "Distribute exactly 100 points in five-point steps. Higher priority changes future draws and redraws; it does not award Core or reroll current candidates.\n\nDesign/Alpha ranges start at 20–40 per Core category. Each completed Project Manager course lowers the minimum and raises the maximum by five, up to 0–60 after four courses. Beta uses QA and Marketing only, starting at 40–60 and reaching 20–80. Insider remains zero and unavailable.\n\nInitial setup for each phase is free. Committing a changed distribution later costs one productive cycle, retains the current pool and restores one redraw up to four. Cancel is free.\n\nAn appropriately trained Production Specialist can offer a bundled change with a qualifying Design/Alpha hand. It keeps that hand's ordinary one-cycle cost and spends the employee's once-per-project use."),
			_page("core", "Core scores", "Graphics, Sound, Technology and Design measure quality.", "Cards add their printed Core contributions to the project. Multi-score Features contribute to every printed Core field; Scope is separate.\n\nReview compares each score with that project's Genre standard. Compare percentages, not just raw points: 20/20 is further along than 30/60.\n\nBalanced progress toward those four standards matters. Raising one category far past its standard cannot fully hide three neglected categories. The HUD shows your current values and targets."),
			_page("genre_targets", "Genre standards", "Base Genre ratios and the current project's actual standards are different views.", "Base Genre standards are shown as [b]Graphics / Sound / Technology / Design[/b]. Their four-category baseline totals 132 points. The table below lists the current base definitions.\n\nYour active project's actual standards can include its frozen market/rival lifts. Use Pre-Development, the HUD and target tooltips for that project's saved values; they need not total the base 132.\n\nCompare progress as percentages of the project's own standards. These are Review targets, not the priorities allocated to future draws."),
			_page("scope", "Scope, engine capacity & completion", "The 30-Scope Review requirement is separate from the engine limit.", "Features add printed Scope. Passes add no Scope; hand synergies do not multiply it. The normal project requirement remains 30.\n\nEngine capacity is a hard played-Scope limit frozen at Begin. Public Action allows 27. A new $100 proprietary engine allows 25, with free automatic milestones at 30 and 35 after all four Generation I and II nodes respectively are purchased. Started projects keep their previous frozen limits.\n\nA hand exceeding remaining capacity is rejected before commitment. Filling a 25- or 27-Scope engine does not turn it into a 30-Scope game: the incomplete-Scope Review factor still applies. Scope completion is capped at 100% for Review.\n\nBelow-target projects can proceed with a warning. Zero-work or Pass-only projects cannot produce a sales-bearing release. Core quality and remaining Bugs still matter."),
			_page("hands", "Cards, short hands & Pass Budget", "Play one to four cards; four are required for hand synergies.", "Design, Alpha, Beta and Contracts accept one to four selected instances when the hand is legal and affordable. Short hands still cost one productive cycle. Four-card Specialization, Balanced Production, QA/Marketing Specialization and Manager Specialization-course credit do not activate from short hands.\n\nAn ordinary pool aims for seven candidates when legal supply allows. Unplayed cards retain their instances and order. After a hand, fill only the gap below seven; no ordinary replacement is added while seven or more remain. Features are finite per project/Contract; renewable Passes can return.\n\n[b]Design/Alpha Pass Budget[/b]\nEach phase has independent counters. For new version-2 projects, total generated allowance = 10 + floor(cumulative printed Feature Core in that phase / 8). Each played Core Pass spends one. Feature primary and secondary printed Core earn allowance; Pass output and synergy gains do not. Retained Passes reserve allowance. Existing active version-1 projects retain 2/K8.\n\nPurchased Generation I engine nodes add 20% of matching printed Feature Core to the allowance numerator, retaining fractions. This changes neither printed Core nor Pass output. Beta and Contracts have no new starting quota.\n\nCheck cost, frozen Scope limit and available budget before commitment. Failed actions do not spend cards, cash, cycles or draw RNG."),
			_page("redraw", "Redraw & sorting", "Replace cards with shared redraws; sorting remains free.", "Each replaced card consumes one shared redraw and no cycle. The bank caps at four. Successful productive cycles restore one; successful phase/Studio entry retains its normal refill rule.\n\nA replacement clears its selection and follows legal supply, priorities and Design/Alpha Pass Budget. Protected Playtest Passes cannot be redrawn. With earned Production Pass Alignment, one eligible ordinary Pass can open a chosen matching replacement or ordinary redraw; Cancel and stale choices spend nothing.\n\nSorting changes arrangement only. Design, Alpha and Contracts use their category/Scope organization; Beta groups QA and Marketing while Insider is held. Sorting neither draws cards nor changes game state."),
			_page("synergies", "Production synergies", "Four-card Specialization or Balanced Production can improve Core output.", "[b]Specialization[/b]\nAn actual four-card Design/Alpha hand sharing one primary Core category gets the base +50% Core multiplier. Passes count; Scope stays printed. Applicable engine bonuses enter the existing Specialization calculation. Short hands never specialize.\n\n[b]Balanced Production[/b]\nAn actual four-card hand with a Feature can qualify when all categories contribute and either highest minus lowest is at most one point, or each gain is within ±15% of the raw four-category average. Count printed primary and secondary contributions, not accumulated scores or Genre percentages. For example,2/2/3/2 qualifies.\n\nMultiply raw hand Core by 1.25, floor once, then split evenly. Spare points go Graphics, Sound, Technology, Design:21 becomes 26, split 7/7/6/6. Specialization takes precedence; they do not stack. Scope and printed Bug Pressure are unchanged."),
			_page("playtests", "Host Playtest", "Two corrective Passes join the current pool immediately.", "Alpha and Beta choose the two lowest current Core/Genre-standard percentages, not the two smallest raw scores:20/40 is weaker than 15/20. Ties retain the phase's deterministic order.\n\nA successful Playtest immediately appends two protected corrective Passes, preserving existing cards and selection. Seven candidates become nine. Ordinary replacement draws wait until fewer than seven remain. Corrections cannot be redrawn away; short hands do not discard overflow.\n\nAlpha costs no cash and one productive cycle; its corrections must fit current Pass allowance and reservations. Beta costs $500 and one productive cycle. Each played correction supplies its printed +2 Core. Beta corrections do not count as QA or Marketing for those synergies.\n\nPlaytests add no Scope and resolve no Bugs directly. Inspect actual affordability and eligibility before committing."),
			_page("bugs", "Bug Pressure & QA", "Hidden Bugs must be found before they can be fixed.", "Production's Bug Pressure contributes to the Bugs you carry into later development. In Beta, Search reveals Hidden Bugs as Known Bugs; Debug removes Known Bugs.\n\nSearch resolves before Debug within a hand, so a combined QA hand can reveal then fix. Debug cannot fix Bugs that remain hidden.\n\nBoth remaining Hidden and Known Bugs affect Review. Fixed Bugs are no longer remaining Bugs. Watch the Known / Fixed readout and use Search when your known count is low but you suspect hidden work remains."),
			_page("beta", "Marketing & QA", "Beta can build audience as well as polish.", "Marketing cards build output used in launch Awareness. Insider cards and their priorities are temporarily disabled; there are no Insider income or reveal actions during this hold.\n\nFour QA cards trigger QA Specialization; four Marketing cards trigger Marketing Specialization. Each gives a 50% boost to its eligible work.\n\nBalanced Operations is unavailable while Insider cards are disabled. Design/Alpha's score-redistributing Balanced Production is unchanged."),
			_page("review", "How Review works", "Quality, completion and remaining Bugs combine into the final rating.", "[b]Core quality[/b]\nEach Core score is divided by its Genre standard, capped at 125%. Review rewards the average progress and penalizes uneven ratios.\n\n[b]Completion and polish[/b]\nScope completion scales that production rating up to 100%; remaining Hidden and Known Bugs reduce it. A small review variation is then applied and the final result is rounded to one decimal, capped at 10.0.\n\nMarketing does not directly increase this base rating. After launch, Detailed Review shows the frozen calculation; reopening it does not roll again."),
		]),
		_section("store", "Engine Features", "Implement Features in your engine, or inspect fixed provider libraries.", [
			_page("map", "Read an engine Feature tree", "Open an owned engine, then inspect its implementation map.", "Studio Management → Engines → owned engine → Feature Implementation Tree opens the map. Public and licensed details show fixed read-only libraries instead. There is no global Studio Store action.\n\nInspect the node's phase, printed Core/Scope, prerequisites, era gate and quote. Simple Story is needed for Dialogue or Character Backstories; Levels is needed for Maps or Exploration. Prerequisites belong to this engine: a queued parent is not a completed parent.\n\nPaid completion supplies that engine's future pool automatically. There is no new Stage/Commit step. Active projects and accepted Contracts retain frozen supply; availability never guarantees a draw.\n\nThe queue dropdown inspects pending work without reordering it. Implement completes the legal FIFO head through its engine. Zoom and Show all are free navigation."),
			_page("ownership", "Engines, Features & Skill Tree", "Ownership, technology foundations and Feature supply are separate.", "[b]Fixed provider libraries[/b]\nPublic Action provides 17 Features/27 maximum Scope for no upfront payment and 30% post-platform Studio royalty. It is read only, with no player Skill Tree. Current new Puzzle/Adventure licenses cost $2,500, allow 27 Scope and charge 15% post-platform creator royalty. Existing licenses retain saved historical terms.\n\n[b]Create your own[/b]\nA named proprietary engine costs $100 and no productive cycle. It has zero engine royalty,25 maximum Scope and an empty Feature pool. Its four free technology foundations—Text,4-Color Palette, Keyboard & Mouse,8-Bit Sound—are not grants of those Feature cards. Implement cards separately. Paid completion automatically supplies that engine's future games; another engine receives no implementation from it.\n\n[b]Independent Skill Tree[/b]\nGraphics, Sound, Technology, Design challenges track accepted printed Feature Core from projects using this engine. Passes, synergies and replays do not train them. Generation I thresholds are 5/5/6/3; II thresholds 10/10/12/6. Completed nodes cost $125 in I or $250 in II, take no cycle and open only that branch's successor. Challenges begin free and progress persists per engine.\n\nFour purchased I nodes automatically grant 30 capacity; four II nodes grant 35. These milestones are free. III/IV remain unavailable. The project requirement stays 30; active projects retain frozen capacity/supply.\n\nCurrent trial effects: I adds 20% of matching printed Feature Core toward Pass Budget only. II Graphics/Sound add 10% of matching Pass marginal Core with fractional carry; Technology/Design reduce only matching printed Feature Bug Pressure portions by 15%. They grant no Feature cards and change no printed Scope."),
			_page("research", "Implementation queue", "Pay the deposit, then complete the legal FIFO head in its engine.", "New paid implementations share one Studio-wide FIFO queue; every entry is bound to an engine. Admission pays half the current familiarity-discounted whole price, rounded up to cents, and costs no cycle. The deposit is irreversible; no cancellation or reordering.\n\nOnly the global head can complete through its engine. Pay the fresh remaining balance and spend one productive cycle. Completion permanently implements the Feature and automatically supplies that engine's future projects in the same action. No extra staging/commit cycle is required.\n\nThe dropdown inspects work without changing FIFO. Another engine's head, missing prerequisites, insufficient funds or checkpoint failure can keep Implement unavailable. Check engine title and current quote.\n\nFamiliarity may reduce an unpaid balance; eligible Resourceful savings apply to the final payment. Previously paid legacy work retains saved terms. Existing projects/accepted Contracts never acquire these Features mid-project."),
			_page("familiarity", "Familiarity & savings", "Parent-Feature experience discounts the whole implementation price, up to 80%.", "Accepted Feature plays grant normal familiarity once per Feature per project. The ledger is shared across engines. Familiarity credits on a new Feature's listed parents reduce its whole base implementation price by 10% each, capped at 80%.\n\nAdmission splits that discounted total into deposit and balance. Later familiarity may reduce unpaid balance, never refund a deposit or increase an admitted price. Prerequisites must still be implemented in this engine.\n\nResourceful saves up to $100 on the first eligible paid acquisition per release window, applied to the final balance for queued work. The quote shows the actual saving.\n\nFamiliarity grants neither free cards nor a free completion cycle. Paid completion supplies future games automatically; existing projects keep frozen supply. Historical paid queues retain their saved prices."),
		]),
		_section("publishers", "Publishers", "Cash Contracts, Reputation Briefs and optional commissioned games.", [
			_page("offers", "Profiles & offers", "Use Publisher List to see what unlocks the next opportunity.", "Publishers have distinct release and Contract requirements. A profile becoming visible does not mean every offer is available. Read its actual unlock and offer status.\n\nBefore accepting, inspect the hand count, target distribution, advance, possible final cash and Promotion. The reward depends on completion; the maximum is not guaranteed income.\n\nAcceptance itself is free in time. Once accepted, a Contract cannot be abandoned through an ordinary cancel action."),
			_page("contract_hands", "Play a Contract", "Use one to four cards per hand; four are needed for Specialization.", "A successful Contract hand accepts one to four legal instances and costs one productive cycle. A short hand still consumes one of the offer's required hands, so inspect targets before committing.\n\nFinite eligible Features come from the engine pool frozen at acceptance; Core Passes renew. Contract Feature play is free, but rent, payroll and debt follow the normal productive clock. There are no mid-Contract Continue saves.\n\nAn actual four-card hand sharing one primary Core specializes: +50% Core while Scope stays printed. Short hands never specialize; Contracts do not use Balanced Production.\n\nMost offers require two successful hands; Starwave requires three. Acceptance, browsing and results dismissal cost no cycle. Accepted work cannot be abandoned. Completion applies its frozen payout once before that cycle's ordinary settlements and bills."),
			_page("ironclad", "Ironclad & SideStreet", "Balanced jobs can fund the next project.", "Ironclad's balanced offer provides an acceptance advance and a completion-based final payout. Publisher Connections increases the first Ironclad advance, without increasing the full reward pool.\n\nSideStreet is a cash-focused balanced Contract with no advance. Find repeatable work through Contracts → Search. Choose an unlocked publisher and work type first. A successful search costs one ordinary productive cycle with no direct cash fee; it creates one durable offer without accepting it. Pending older offers remain available first.\n\nBuild toward the displayed Scope and all four Core targets. Surplus in one capped objective cannot replace missing progress in another." + _challenge(ContractDefinitions.SIDESTREET)),
			_page("sidestreet_briefs", "Reputation Briefs", "SideStreet standing is separate from cash Contracts.", "A Reputation Brief requires two successful hands, each accepting one to four cards, with targets Scope 10 and Core 3 per category. It pays no cash, Promotion or Investment. Each hand costs one productive cycle; ordinary bills continue.\n\nAward up to 10 Reputation using the lower of completion and promise, floored to 0.01. With no successful redraws, Scope ≤ 10 keeps full promise;11 halves it;12+ gives zero. Any successful redraw also gives zero promise. Completion retains its 64-unit denominator.\n\nContracts → Search finds repeatable Briefs for one additional productive cycle and no direct fee. Existing pending/original rights remain; no new release is required after finishing a Brief. Briefs do not count as cash Contract completions.\n\nAt Reputation 20 and with a released game, Search for a commission invitation before preparing the publisher-owned game. Access spends no standing."),
			_page("sidestreet_commissions", "Commissioned games", "Optional publisher-owned games at SideStreet Reputation 20.", "First find a commission invitation with a one-cycle Search at Reputation 20 and at least one released game. Browsing and canceled preparation keep the same invitation; only successful Begin consumes it. Choose the name, Genre and Theme, then review the actual prepared Scope and Review 6.0 target before Begin. Begin costs one productive cycle and locks the terms; there is no cancellation afterwards.\n\nThe full fee is $6,000. It scales with the lower of Scope delivery and Review delivery, rounded down to cents. At full Scope, Review 5.0 pays $3,000; 5.9 pays $5,700; 4.0 or below pays zero. Only full delivery requests +15 Reputation and +15 Investment; each standing caps independently at 100. Every result is recorded once, including zero.\n\nThe publisher owns sales. Raw units, title history and Fans remain; Studio/Bank sales income is zero, and Studio post-launch campaigns are unavailable. Banked Promotion is consumed normally by this successful launch. The fee is a separate publisher receipt and can service arrears.\n\nContinue remains Studio-only. After completion, search for a new commission invitation before preparing another. Investment-funded support is a separate Studio-owned agreement. Later publisher tiers remain unavailable."),
			_page("sidestreet_support", "Investment support", "Optional funding for a Studio-owned game at SideStreet Investment 15.", "Read the frozen quote before Begin: it shows upfront cash, launch Marketing and the full recoup budget. Begin advances one productive cycle and pays funding once. Preview and Back spend nothing. Funding is financing, not sales or profit.\n\nYou own this game. The publisher recoups 20% of its cumulative post-store net sales, rounded down to cents, up to the quoted full budget through earning cycle 24. Other titles are untouched. Unrecouped budget expires without becoming debt. Launch Marketing is applied once before existing trait conversion.\n\nAt earning cycle 6, Review at least 7.0 and at least 1,000 actual cumulative units request +10 Investment, capped at 100. A miss gives no award or penalty. The assessment stays recorded, including success at the cap.\n\nRenewal requires the latest support assessment to finish, a later Studio-developed release, and a new successful support assessment or full SideStreet commissioned delivery after the previous acceptance. The earliest qualifying recorded event is used once. Another agreement can coexist with the older game's remaining recoup. Continue remains Studio-only."),
			_page("crown", "Crown & Quill", "A broad hand matters, especially its weakest category.", "Crown & Quill values Scope and four-Core progress, with extra weight on the weakest Core result. Neglecting one category can therefore hurt more than its individual target suggests.\n\nThe offer includes an advance and can award Promotion as well as cash. Read the frozen offer's targets and maximum rewards before accepting.\n\nUse its result screen to see how much of the potential payout you actually earned." + _challenge(ContractDefinitions.CROWN)),
			_page("neon", "Neon Circuit", "Build around the focus selected from the accepted engine pool.", "Neon's focus is selected from eligible Feature primary Core in the engine pool frozen at acceptance. Passes and secondary Core do not select it. Ties use Graphics, Sound, Technology, Design order.\n\nIts two successful hands accept one to four cards each. Four matching primaries can specialize. It has no advance, a Scope target of 10 and stronger focused-Core weighting. Plan both hands so finite Features support the whole offer.\n\nCurrent base cap: $1,560 and 20 Promotion, scaled by completion. Its independent challenge asks for total final Core at least 1.5 times final Scope; lower ratios receive proportional grade. New challenge-enabled offers may add up to $100 and 4 Promotion without reducing base reward. Accepted/historical terms remain frozen."),
			_page("starwave", "Starwave", "Three successful hands give a longer production challenge.", "Starwave requires three productive successful hands. Each accepts one to four legal cards and costs one cycle; four matching cards are needed for Contract Specialization. No advance or cash is paid after the first two hands.\n\nBase targets are Scope 14 and Core 7 per category. Full base completion pays $2,240 and zero base Promotion; incomplete delivery scales down through the frozen formula.\n\nThe separate challenge aims for exactly 7.0 per final Core. Above/below both count as deviation; total deviation 8.0 earns zero challenge bonus. New challenge-enabled offers may add up to $100 and 4 Promotion. Old completed offers gain no retroactive bonus.\n\nKeep cash for bills across all three hands and read the actual offer before accepting."),
			_page("promotion", "Promotion", "Banked Promotion belongs to your next successful release.", "Eligible publisher rewards add Promotion to a bank. That bank contributes to the next successfully launched game's Awareness, then is consumed once.\n\nCanceled or failed launches do not spend it. It does not raise the base Review, pay cash by itself or retroactively change an earlier release.\n\nCheck your Contract result and launch Awareness breakdown to see the contribution."),
		]),
		_section("sales", "Sales & Fans", "Follow your games beyond launch day.", [
			_page("launch", "Launch results", "Review and Awareness do different jobs.", "Review reflects production quality, Scope and Bugs. Awareness measures launch visibility from Marketing, Fans and applicable bonuses. Frozen market context also helps determine projected units.\n\nLaunch locks those results. The first-month projection is a forecast, not a cash payment. Released games begin earning as later productive cycles advance.\n\nUse Detailed Review and the summary breakdown to trace the result instead of reading projected revenue as spendable cash."),
			_page("sales_hud", "Sales graph", "Watch actual revenue accumulate across released games.", "The shared top-HUD graph shows up to 12 calendar months, separating the current partial month from past months. New earned revenue animates the current bar.\n\nEarned sales, settled cash and bankroll are different values. Applicable platform share and frozen engine/publisher rights are handled in each title's actual ledger; rent and payroll remain separate expenses.\n\nHover for exact cents and earned/paid amounts. The graph advances with productive cycles, not real-world waiting. Use Monthly Sales for a title and Finances for the combined calendar view."),
			_page("earning", "Earning & settlement", "Earned revenue is not automatically spendable cash.", "Releases age on the shared productive calendar: four cycles per month and 48 per year for new Studios. Existing saves keep past dates and earnings while future actions advance one quarter-month at a time.\n\nEligible earned revenue becomes cash at its ordinary settlement boundary. Platform share and frozen engine royalties use the cumulative exact-cent sales ledger; reports and Continue never charge them again. Publisher-owned commissions and supported titles retain their separate sales-rights/recoup terms.\n\nTitle age months can differ from calendar months. A launch projection is a forecast, not a deposit. Monthly Sales and Finances separate earned, settled and outstanding amounts."),
			_page("lifespan", "Lifespan & campaigns", "An older game can keep selling, fade to zero, or receive a campaign.", "Organic Awareness changes as a title ages, so monthly sales need not stay at the launch projection. There is no hard expiration: zero-sales titles remain on market.\n\nAn eligible campaign costs $100 and one productive cycle. It temporarily boosts that title's active Awareness for its current age month; it does not permanently lift organic retention.\n\nCampaigns start from release-age month two and must precede that month's first earning cycle. Later repeat campaigns give smaller boosts. Inspect the eligibility message before committing."),
			_page("fans", "Fans & Awareness", "Fans represent an estimated audience for the studio.", "At launch, the current Fan count is frozen for that game's fan-derived Awareness. The current trial contributes one Awareness per four Fans, rounded down, up to 150.\n\nFans are not guaranteed buyers, and copies sold do not identify unique people. The game uses an estimated audience model for growth and loss.\n\nOpen the Fans button to inspect recent monthly changes. New Fans can help future launches; they do not rewrite an earlier launch snapshot."),
			_page("fan_changes", "Growing or losing Fans", "Quality and actual exposure shape monthly audience changes.", "Reviews above 5.0 can recruit Fans through eligible earned sales. Reviews below 5.0 can lose Fans as more of the launch audience is reached. A 5.0 Review is neutral in the current model.\n\nLoss is incremental: the same title does not charge again for exposure already counted. Small calculated changes may round to zero.\n\nSeveral games share one monthly audience boundary. A poor release can matter after launch, but a zero-sales month is not an automatic repeat loss."),
		]),
		_section("finance", "Finances", "Protect the runway for your next productive action.", [
			_page("calendar", "Time & bills", "Four productive cycles make a month;48 make a year.", "Hands, Begin Development, implementation completion, Playtests, Search and eligible campaigns advance the shared calendar. Browsing, help, sorting, ordinary redraws and free previews do not.\n\nNew Studios pay $300 monthly rent or $315 with Expensive Lease. Existing Studios keep saved rent and issued bills. Employee, Bank and education obligations retain their own schedules. The footer and Finances show date and next dues.\n\nProductive actions also advance sales and eight rivals. Annual Awards freeze once at the committed December Week 2 cutoff; watching pages adds no productive time.\n\nThere is no free Wait or offline-income clock. Check the next monthly boundary before spending your remaining cash. Continue preserves historical dates rather than recalculating old actions."),
			_page("ledger", "Cash, revenue & profit", "Cash on hand is not the same as monthly profit.", "Open Cash to view Studio Finances. Earned sales are operating revenue; settled sales are actual cash received. Development costs, rent, wages and interest affect expenses.\n\nA loan or startup financing puts cash in the account without being game-sales revenue. Repaying principal reduces cash without being a new operating expense.\n\nCurrent-month rows are partial. Compare the earned, paid and outstanding amounts before deciding what you can afford."),
			_page("arrears", "Unpaid bills & signed bankroll", "Spendable cash differs from the balance after overdue bills.", "The cash wallet cannot fall below zero. A signed bankroll overview subtracts overdue obligations and may be negative while cash remains. Finances shows actual cash and unpaid bills.\n\nBlocking bills may prevent spending or productive actions unless the action's genuine receipt or settlement can cover obligations. Free browsing and phase exits remain separate.\n\nAutomatic service pays rent first, payroll next, then Bank/education by original due date, with Bank first on equal dates. Debt installments pay interest before principal.\n\nPartial payment never resets a bill's age or late history. Borrowing or a genuine publisher receipt may service arrears through the actual quote; opening a menu cannot forgive debt."),
			_page("bank", "Bank loans & payoff", "Inspect ordinary income capacity and the bounded recovery facility.", "Open Studio Info → Bank or Cash → Bank. Ordinary capacity uses settled sales and obligations, including existing Bank commitments. Forecasts and credit score do not create capacity. Enter amount/term and inspect the adjusted quote and payment breakdown.\n\nCurrent minimum principal is three times actual monthly rent. A cash-poor Studio lacking ordinary capacity may qualify once for the bounded three-rent recovery facility. It remains a loan with ordinary interest and repayment. Due obligations may be deducted from proceeds; the quote separates recovery and net cash.\n\nConfirmation uses displayed valid terms. Borrowing spends no cycle but creates installments; allow for rent and wages as well. Early payoff needs a current quote and enough cash for balance/due obligations.\n\nCancel or reopening is free. Repeated confirmation cannot borrow or pay twice."),
			_page("credit", "Credit & education debt", "Credit follows monthly financial history.", "On-time, profitable months can improve credit. Overdue bills can reduce it; repeatedly opening menus or taking loans does not farm credit.\n\nCollege Dropout and Graduate can add education debt when chosen for a new Studio. They provide Trait points rather than a cash loan deposit. Check the selection's grace period and payment schedule.\n\nFinances shows education balances and payoff terms. Education-only arrears do not block production, but they still affect credit and Bank eligibility."),
		]),
		_section("rivals", "Rivals", "Other studios share the calendar.", [
			_page("competition", "AI competitors", "Eight rivals advance only when productive game time advances.", "The current new-game trial has eight live rival Studios. They develop/release games, earn sales, pay obligations and contribute to market pressure as productive time advances.\n\nYour choices control your own Studio and hands. Browsing, help, pause and waiting in real time grant no rival turns.\n\nMarket Info → Rival Info shows visible Studio facts; the market browser shows actual releases. Historical records are separately labelled, with no invented sales units.\n\nBeta Insider cards and priorities are disabled. The hold grants no Insider income or new forecast/competitor reveal action. Frozen project/launch information is available only through the screens and saved context that actually expose it."),
			_page("market", "Market information", "Compare actual releases and the values frozen for your project.", "Market Info contains the market browser, Rival Info and Publisher List. All/AI include typed Historical records; Your Studio excludes them. Historical units are unavailable; live rows use each owner's actual ledger.\n\nThe trial uses monthly snapshots and a six-calendar-month active-release presence window. Rival Genre pressure can raise future Core standards by up to 4 points; strong actual-Core benchmarks can lift individual standards by up to 8. The larger lift applies. Historical baseline standards remain separate from active sales. Project standards freeze at Begin.\n\nSales separately count Genre-only, Theme-only and matching-pair competitors, including your other titles. Current penalties are 6%,3%,12%, with a 70% factor floor. A release-age month's earning cycles retain their frozen factor. Setup, target tooltips, Detailed Review and Monthly Sales explain saved values.\n\nOrdinary Beta has no Insider research reveal during the hold. A projection is information, not promised cash. Current market numbers remain trial values."),
		]),
		_section("controls", "Controls", "Navigate safely and keep your place.", [
			_page("navigation", "Mouse & keyboard", "Choose folders above, then topics on the left.", "Click a folder or topic to read it. Tab and Shift+Tab move through the guide's controls. Left/Right moves between top folders; Up/Down moves through the topic list. Enter or Space activates a focused button.\n\nScroll long pages with the wheel, the scrollbar, or Page Up / Page Down. Escape closes the guide and restores focus to the button that opened it.\n\nIn play, click cards to select them and inspect the displayed hand before committing. Hover card fields and HUD values for extra detail."),
			_page("pause", "Pause & Settings", "Escape pauses play while the music keeps going at your chosen volume with room reverb.", "Resume continues the current state and returns to the normal music mix. Card animations rejoin the music rhythm. How to Play opens this reference while the game stays paused; closing it returns to Pause. Settings also works while paused.\n\nSettings controls window mode, window size and Master, Music and SFX levels. Display changes require confirmation and can revert if you do not keep them.\n\nMain Menu may ask you to discard work since the last Studio checkpoint. Cancel returns to Pause without losing that work."),
			_page("continue", "Saving & Continue", "Continue restores the last committed Studio checkpoint.", "The game saves at committed Studio boundaries, including supported Studio actions and returns after release or Contract completion.\n\nDevelopment and active Contract hands are not mid-phase saves. Leaving during them discards progress since that checkpoint, including an unsaved Contract advance. Returning to Main Menu explains the rollback before you confirm.\n\nContinue restores the saved state without replaying payouts or earning offline sales. New Run warns before replacing an existing saved Studio."),
			_page("help", "Tips & this guide", "Use short hints in play and the full reference when you need it.", "The footer Tip button explains the current situation. Tutorial opens short context-specific phase tips. This How to Play guide is available from Main Menu and Pause.\n\nBrowsing this reference is free: it does not spend redraws, advance the calendar, change priorities or mark a training challenge complete.\n\nFor exact transaction amounts, use the game's current quote and result screen. This guide explains how to read those choices."),
		]),
	]

static func _section(id: String, label: String, subtitle: String, topics: Array) -> Dictionary:
	return {"id":id,"label":label,"subtitle":subtitle,"topics":topics}

static func _page(id: String, title: String, summary: String, body: String) -> Dictionary:
	return {"id":id,"title":title,"summary":summary,"body":body}

static func _genre_targets() -> String:
	var lines: Array[String] = ["Standards are shown as [b]Graphics / Sound / Technology / Design[/b]. All current Genres total 132, derived from the four-category 33-point baseline.\n"]
	for genre: Dictionary in PrimitivePredevelopment.catalog().genres:
		var targets: Array = PrimitiveReviewCalculator.GENRE_TARGETS[StringName(genre.id)]
		lines.append("[b]%s[/b]  %d / %d / %d / %d" % [genre.name,targets[0],targets[1],targets[2],targets[3]])
	lines.append("\nChoose hands by progress toward your project's standards. These are Review targets, not the percentages you allocate in the priority menu.")
	return "\n".join(lines)

static func _traits() -> String:
	var lines: Array[String] = ["Choose any number of distinct Traits while keeping the final point balance nonnegative. Choosing none is valid. Read both the immediate effect and the long-term cost.\n"]
	for entry: Dictionary in StudioTraits.TRAITS.values():
		lines.append("[b]%s · %s[/b]\n%s\n" % [entry.name,entry.price,entry.description])
	lines.append("Check Overview before confirming. Existing Studios retain the Trait effects under which they were created.")
	return "\n".join(lines)

static func _challenge(kind: StringName) -> String:
	return "\n\n" + ContractChallenges.description(kind) + "\nThe current trial adds up to $100 and 4 Promotion, graded independently of base completion. Missing the challenge never reduces the base reward. Terms freeze when accepted; old completed Contracts receive no retroactive bonus."
