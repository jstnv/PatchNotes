class_name HowToPlayContent
extends RefCounted

## Player reference for current runtime rules, independent of run/save state.
## Keep this alongside presentation code: help edits are not content migrations.
static func sections() -> Array:
	return [
		_section("start", "Start Here", "Your first studio, from an idea to a release.", [
			_page("loop", "The game loop", "Build games. Learn from each release. Grow your studio.", "[b]1 · Set up[/b]\nName your studio, choose a permanent Genre specialty and review optional Traits. Enter Studio, then name your first game and choose its Genre and Theme.\n\n[b]2 · Develop[/b]\nDesign and Alpha build Core quality and Scope. Beta searches for Bugs, fixes them and builds Marketing. Choose four cards for each hand.\n\n[b]3 · Release and return[/b]\nInspect the frozen Review and launch results. Released games earn sales while later productive actions advance time. Back in Studio, research Features, explore Contracts and plan the next project."),
			_page("specialty", "Genre specialty", "Your studio specialty supplies a starting pool, not a restriction on future games.", "Choose one permanent specialty in the Genre Specializations folder. Preview its free Features before confirming. Those Features remain owned by the studio.\n\nEach new project can use any available Genre. Its Genre determines its four Core Review standards, so a pool suited to one Genre may need additions for another.\n\nThe specialty preview is the place to compare the actual starting cards. Your project Genre and studio specialty are separate choices."),
			_page("setup", "Setup folders", "Explore Genre Specializations, Traits and Overview before entering Studio.", "Use the top folders to review your choices. An asterisk marks a folder needing attention. Opening Traits clears its asterisk even when you choose none.\n\nOverview summarizes your choices. Changing a choice after visiting Overview marks it for review again. Confirm only after checking your starting Features, financing and any ongoing obligations.\n\nBacking out of setup does not create a studio or charge time."),
			_page("first_game", "First game checklist", "Keep one eye on quality and one on the next bill.", "Start with the Genre targets in the HUD. Build toward the Scope target while raising the weaker Core percentages. Save money for later hands and rent.\n\nIn Alpha, use a Playtest when you want corrective Core cards. In Beta, reveal Hidden Bugs before relying on Debug, and leave room for Marketing.\n\nBefore launching, inspect remaining Bugs and Scope. A bigger game is not automatically a better-reviewed game."),
		]),
		_section("studio", "Studio", "The home of your studio's long-term decisions.", [
			_page("hub", "Studio Phase", "Browse, plan and choose what to do next.", "Post Game Summaries holds release history. Feature Store grows your owned pool. Publisher List explains unlocks, Contracts offers paid work, and Employees manages your current specialist.\n\nProduce Next Game opens project setup. Browsing menus costs no cash or cycles. Buying, researching or accepting an offer follows the terms shown before confirmation.\n\nReturning to Studio refills the shared redraw budget to four. Simply reopening a menu does not grant another refill."),
			_page("project", "Start a project", "Choose a name, Genre and Theme before development begins.", "The project keeps these choices throughout development. Genre sets the Core standards shown in the HUD. Themes currently identify the project without adding a scoring bonus.\n\nEditing or canceling the form is free. Begin Development advances the run calendar by one productive cycle, while the new project's own cycle count starts at zero.\n\nOwned Features carry forward, but finite Feature usage resets for the new project."),
			_page("traits", "Studio Traits", "Optional choices can change both opportunities and obligations.", _traits()),
			_page("employees", "Hire an employee", "The current Production Specialist becomes available after your first game.", "Open Employees to inspect and confirm a hire. The current trial hire costs $100 and no cycles, requires affordable cash and current bills, and adds $10 monthly payroll.\n\nThe first payday is at the end of the first full month after hiring. Hiring halfway through a month does not charge a full wage at that month's end.\n\nCourses and additional specialist roles are not currently available. Read the actual hire quote before spending."),
			_page("training", "Employee training", "Train Production with a matching Pass and Feature in a successful Design hand.", "A Core Pass must match a Feature's printed primary or secondary Core category in the same Design hand. Successful training permanently belongs to that employee.\n\nA trained specialist can bundle one changed Design or Alpha priority distribution per project into a later qualifying hand. This avoids a separate priority-change cycle; the hand still uses its normal cycle.\n\nThe training hand cannot spend the benefit it just earned. Preview and accept the bundled plan when offered; declining does not spend it. Training adds no direct Core bonus."),
			_page("history", "Release history", "Review what actually happened to each game.", "Open Post Game Summaries, then choose a release. Detailed Review explains its final rating. Monthly Sales separates earned revenue from paid cash. Run Campaign appears when that title is eligible.\n\nResults are frozen at launch. Looking at a report cannot reroll Reviews, pay a reward again or advance time.\n\nUse older games' results to judge your next Genre, pool and cash plan."),
		]),
		_section("development", "Development", "From four-card decisions to a finished game.", [
			_page("phases", "Design → Alpha → Beta", "Each phase asks a different question.", "[b]Design:[/b] implement Features and build the project's foundation.\n\n[b]Alpha:[/b] expand production, improve Core scores and test the game. Production generates Bug Pressure that affects later bug work.\n\n[b]Beta:[/b] Search, Debug, Marketing and Insider work prepare the release. Phase changes are not extra production hands.\n\nChoose when to move forward. More hands can improve a game but also use money and calendar time."),
			_page("priorities", "Category priorities", "Priorities influence future draws; they do not award points.", "In Design and Alpha, distribute 100 priority points in 5-point steps, keeping each Core category between 5 and 50. Higher priority favors that category in future draws and redraws.\n\nThe first priority setup for a phase is free. Changing an already committed distribution costs one productive cycle and keeps the current candidates.\n\nBeta has its own QA, Marketing and Insider priorities. Check the displayed total and valid range before committing. A trained Production employee may offer a bundled change during Design or Alpha."),
			_page("core", "Core scores", "Graphics, Sound, Technology and Design measure quality.", "Cards add their printed Core contributions to the project. Multi-score Features contribute to every printed Core field; Scope is separate.\n\nReview compares each score with that project's Genre standard. Compare percentages, not just raw points: 20/20 is further along than 30/60.\n\nBalanced progress toward those four standards matters. Raising one category far past its standard cannot fully hide three neglected categories. The HUD shows your current values and targets."),
			_page("genre_targets", "Genre standards", "Different Genres emphasize different kinds of quality.", _genre_targets()),
			_page("scope", "Scope & completion", "Scope measures how much game you built, not how polished it is.", "Features add their printed Scope toward the current target. The standard project target is 30. Production specializations do not multiply Scope.\n\nMissing Scope reduces the production contribution to Review. Exceeding the target does not increase the completion multiplier above 100%.\n\nA below-target project may be launchable with a warning, but zero-work or Pass-only projects cannot generate a sales-bearing release. Keep checking Core quality and Bugs as well as completion."),
			_page("hands", "Cards & four-card hands", "Pick exactly four candidates and inspect the hand before committing.", "You draw seven candidate instances and choose four. Selected cards rise into their own fan. The remaining cards stay available; playing a hand replaces played slots rather than throwing away every unselected card.\n\nFeatures are finite within the project. Renewable Core Passes can return. A card's primary category affects Specialization eligibility even if it also contributes to another category.\n\nA successful productive hand spends one cycle and its displayed cost. Failed or unaffordable actions do not secretly resolve cards."),
			_page("redraw", "Redraw & sorting", "Use redraws to improve the hand without spending a cycle.", "Select a card to replace it. Each one-card replacement consumes one shared redraw. The budget caps at four; successful productive cycles restore one, and successful development phase entry refreshes it.\n\nA replaced card clears its selection. The replacement follows the phase's legal supply and priority rules.\n\nSorting only changes the arrangement of the fan. Design, Alpha and Contracts offer category/Scope organization; Beta groups QA, Marketing and Insider cards. Sorting does not create a new draw."),
			_page("synergies", "Production synergies", "Specialization rewards a focus; Balanced Production redistributes an even hand.", "[b]Specialization[/b]\nFour cards sharing the same primary Core category give +50% hand Core gains. Passes count. Scope stays printed.\n\n[b]Balanced Production[/b]\nOtherwise, a hand with at least one Feature qualifies when each of its four unmodified Core gains is within ±15% of the hand's four-category average. Count all printed Core contributions, not accumulated project scores or Genre percentages.\n\nThe original hand total is divided evenly across the four categories. Whole-point remainders go Graphics, Sound, Technology, Design: 21 points becomes 6/5/5/5. No extra points are created. Specialization takes precedence; they do not stack."),
			_page("playtests", "Host Playtest", "Correct the weakest percentages of your Genre standards.", "Host Playtest in Alpha or Beta supplies corrective Core opportunities. Selection looks for the lowest current Core score divided by its Genre standard, rather than simply the lowest raw score.\n\nExample: 20/40 is weaker than 15/20, even though 20 is the larger number.\n\nCheck the displayed cash and cycle cost before confirming. Playtests do not replace the need to play useful cards or finish Scope."),
			_page("bugs", "Bug Pressure & QA", "Hidden Bugs must be found before they can be fixed.", "Production's Bug Pressure contributes to the Bugs you carry into later development. In Beta, Search reveals Hidden Bugs as Known Bugs; Debug removes Known Bugs.\n\nSearch resolves before Debug within a hand, so a combined QA hand can reveal then fix. Debug cannot fix Bugs that remain hidden.\n\nBoth remaining Hidden and Known Bugs affect Review. Fixed Bugs are no longer remaining Bugs. Watch the Known / Fixed readout and use Search when your known count is low but you suspect hidden work remains."),
			_page("beta", "Marketing & Insider", "Beta can build audience as well as polish.", "Marketing cards build output used in launch Awareness. Insider work can reveal competitor or market information, and some actions may provide income. Read the card text for its actual effect.\n\nFour QA cards trigger QA Specialization; four Marketing cards trigger Marketing Specialization. Each gives a 50% boost to its eligible work.\n\nA 2/1/1 mix of QA, Marketing and Insider triggers Balanced Operations: +25% eligible bug work, Marketing and insight chances, without a cash multiplier. It is separate from Design/Alpha's score-redistributing Balanced Production."),
			_page("review", "How Review works", "Quality, completion and remaining Bugs combine into the final rating.", "[b]Core quality[/b]\nEach Core score is divided by its Genre standard, capped at 125%. Review rewards the average progress and penalizes uneven ratios.\n\n[b]Completion and polish[/b]\nScope completion scales that production rating up to 100%; remaining Hidden and Known Bugs reduce it. A small review variation is then applied and the final result is rounded to one decimal, capped at 10.0.\n\nMarketing does not directly increase this base rating. After launch, Detailed Review shows the frozen calculation; reopening it does not roll again."),
		]),
		_section("store", "Feature Store", "Turn cash and time into a broader production pool.", [
			_page("map", "Read the Store map", "Choose a branch, then inspect the selected Feature.", "Nodes belong to areas such as Visuals, Audio, Technology, Gameplay and World Design. Simple Story is required to buy Dialogue or Character Backstories; Levels is required to buy Maps or Exploration. A queued parent is insufficient; retained grants and old owned cards stay usable. Connections show progression; the detail panel explains the exact eligibility and required owned parents.\n\nA visible node is not always purchasable. Read its lock reason, phase, Core values, Scope and price. Features with multiple prerequisites need every required parent.\n\nOwning a card makes it eligible for the appropriate future pool; it does not guarantee that card appears in your next hand."),
			_page("ownership", "Ownership & supply", "Your studio owns Features; each project tracks its own finite use.", "Your specialty grants a starting set. The Store can expand that ownership. Initial Primitive purchases are instant and use zero cycles; later acquisitions follow the Research queue shown in their quotes.\n\nCompleted ownership carries into future projects. A queued or partly paid Feature is not owned yet.\n\nContracts freeze their eligible pool when accepted. Research does not retroactively insert a new card into that frozen Contract supply."),
			_page("research", "Research queue", "Commit the down payment only when you are ready to queue.", "Later acquisitions enter a first-in, first-out queue. Pay half the base price when queuing; that down payment is irreversible. Entries cannot be canceled or reordered.\n\nOnly the queue head can progress. Research pays the next installment and takes one productive cycle. Ownership begins when the entry completes.\n\nWaiting before queuing is a real choice: an early purchase can tie up cash and delay another Feature behind it. Inspect the queue and next bill before confirming."),
			_page("familiarity", "Familiarity & savings", "The final quote matters more than the base price alone.", "Familiarity can reduce Research installments when they are paid. Check the selected entry's current installment rather than assuming its original base price is the amount due.\n\nResourceful can save up to $100 on the first paid Store acquisition in a release window. For queued Research, the saving applies at the final installment, not to the down payment.\n\nA discount does not remove the productive cycle, override prerequisites or grant early ownership."),
		]),
		_section("publishers", "Publishers", "Cash Contracts, Reputation Briefs and optional commissioned games.", [
			_page("offers", "Profiles & offers", "Use Publisher List to see what unlocks the next opportunity.", "Publishers have distinct release and Contract requirements. A profile becoming visible does not mean every offer is available. Read its actual unlock and offer status.\n\nBefore accepting, inspect the hand count, target distribution, advance, possible final cash and Promotion. The reward depends on completion; the maximum is not guaranteed income.\n\nAcceptance itself is free in time. Once accepted, a Contract cannot be abandoned through an ordinary cancel action."),
			_page("contract_hands", "Play a Contract", "Use the same four-card discipline against different targets.", "Each Contract uses four-card productive hands, the shared calendar and redraw budget. Eligible owned Features are finite; Core Passes renew. The frozen offer defines its supply and terms.\n\nFour cards with the same primary Core category trigger Contract Specialization, boosting Core gains by 50% while leaving Scope printed. Contracts do not use Balanced Production redistribution.\n\nMost current offers have two hands; Starwave has three. After the final hand, inspect completion and the once-only payout before returning to Studio."),
			_page("ironclad", "Ironclad & SideStreet", "Balanced jobs can fund the next project.", "Ironclad's balanced offer provides an acceptance advance and a completion-based final payout. Publisher Connections increases the first Ironclad advance, without increasing the full reward pool.\n\nSideStreet is a cash-focused balanced Contract with no advance. Find repeatable work through Contracts → Search. Choose an unlocked publisher and work type first. A successful search costs one ordinary productive cycle with no direct cash fee; it creates one durable offer without accepting it. Pending older offers remain available first.\n\nBuild toward the displayed Scope and all four Core targets. Surplus in one capped objective cannot replace missing progress in another." + _challenge(ContractDefinitions.SIDESTREET)),
			_page("sidestreet_briefs", "Reputation Briefs", "SideStreet standing is separate from cash Contracts.", "A Reputation Brief has two four-card hands: Scope 10 and Core 3 in each category. It pays no cash, Promotion or Investment. Each played hand costs one productive cycle; rent, payroll and Bank obligations continue.\n\nThe award is up to 10 Reputation, using the lower of completion and promise, rounded down to 0.01. Scope 10 or less with no successful redraws keeps the full promise; Scope 11 halves it; Scope 12+ or any successful redraw gives zero. Completion keeps the 64-unit denominator.\n\nSearch for repeatable Briefs in Contracts. Each successful discovery costs one productive cycle in addition to the two hands. The original qualifying unlock Brief and previously pending work are preserved; no new release is needed after completing a Brief. Briefs do not count as completed cash Contracts. At Reputation 20 with a released game, search for a commission invitation, then prepare it. Access does not spend standing."),
			_page("sidestreet_commissions", "Commissioned games", "Optional publisher-owned games at SideStreet Reputation 20.", "First find a commission invitation with a one-cycle Search at Reputation 20 and at least one released game. Browsing and canceled preparation keep the same invitation; only successful Begin consumes it. Choose the name, Genre and Theme, then review the actual prepared Scope and Review 6.0 target before Begin. Begin costs one productive cycle and locks the terms; there is no cancellation afterwards.\n\nThe full fee is $6,000. It scales with the lower of Scope delivery and Review delivery, rounded down to cents. At full Scope, Review 5.0 pays $3,000; 5.9 pays $5,700; 4.0 or below pays zero. Only full delivery requests +15 Reputation and +15 Investment; each standing caps independently at 100. Every result is recorded once, including zero.\n\nThe publisher owns sales. Raw units, title history and Fans remain; Studio/Bank sales income is zero, and Studio post-launch campaigns are unavailable. Banked Promotion is consumed normally by this successful launch. The fee is a separate publisher receipt and can service arrears.\n\nContinue remains Studio-only. After completion, search for a new commission invitation before preparing another. Investment-funded support is a separate Studio-owned agreement. Later publisher tiers remain unavailable."),
			_page("sidestreet_support", "Investment support", "Optional funding for a Studio-owned game at SideStreet Investment 15.", "Read the frozen quote before Begin: it shows upfront cash, launch Marketing and the full recoup budget. Begin advances one productive cycle and pays funding once. Preview and Back spend nothing. Funding is financing, not sales or profit.\n\nYou own this game. The publisher recoups 20% of its cumulative post-store net sales, rounded down to cents, up to the quoted full budget through earning cycle 24. Other titles are untouched. Unrecouped budget expires without becoming debt. Launch Marketing is applied once before existing trait conversion.\n\nAt earning cycle 6, Review at least 7.0 and at least 1,000 actual cumulative units request +10 Investment, capped at 100. A miss gives no award or penalty. The assessment stays recorded, including success at the cap.\n\nRenewal requires the latest support assessment to finish, a later Studio-developed release, and a new successful support assessment or full SideStreet commissioned delivery after the previous acceptance. The earliest qualifying recorded event is used once. Another agreement can coexist with the older game's remaining recoup. Continue remains Studio-only."),
			_page("crown", "Crown & Quill", "A broad hand matters, especially its weakest category.", "Crown & Quill values Scope and four-Core progress, with extra weight on the weakest Core result. Neglecting one category can therefore hurt more than its individual target suggests.\n\nThe offer includes an advance and can award Promotion as well as cash. Read the frozen offer's targets and maximum rewards before accepting.\n\nUse its result screen to see how much of the potential payout you actually earned." + _challenge(ContractDefinitions.CROWN)),
			_page("neon", "Neon Circuit", "Build around the offer's selected focus while supporting the other categories.", "Neon's focus is selected from your eligible owned pool when the offer is accepted. It rewards that focus strongly, with smaller supporting Core targets and a Scope target.\n\nIt has no acceptance advance. Completion can award cash and Promotion; a weak completion can leave either well below its advertised maximum.\n\nPlan the two hands together so finite Features support the full Contract, not only the first hand." + _challenge(ContractDefinitions.NEON)),
			_page("starwave", "Starwave", "Three hands give a longer production challenge.", "Starwave asks for three productive four-card hands with broad Core and Scope progress. It pays no advance and no cash on the first two hands.\n\nIts final payout scales with completion; the base offer awards cash without Promotion; its separate challenge can earn bonus Promotion. Keep enough cash for costs and bills across all three hands.\n\nRead the Publisher List requirements and the actual offer before committing." + _challenge(ContractDefinitions.STARWAVE)),
			_page("promotion", "Promotion", "Banked Promotion belongs to your next successful release.", "Eligible publisher rewards add Promotion to a bank. That bank contributes to the next successfully launched game's Awareness, then is consumed once.\n\nCanceled or failed launches do not spend it. It does not raise the base Review, pay cash by itself or retroactively change an earlier release.\n\nCheck your Contract result and launch Awareness breakdown to see the contribution."),
		]),
		_section("sales", "Sales & Fans", "Follow your games beyond launch day.", [
			_page("launch", "Launch results", "Review and Awareness do different jobs.", "Review reflects production quality, Scope and Bugs. Awareness measures launch visibility from Marketing, Fans and applicable bonuses. Frozen market context also helps determine projected units.\n\nLaunch locks those results. The first-month projection is a forecast, not a cash payment. Released games begin earning as later productive cycles advance.\n\nUse Detailed Review and the summary breakdown to trace the result instead of reading projected revenue as spendable cash."),
			_page("sales_hud", "Corner sales graph", "Watch actual revenue accumulate across your released games.", "The top-right graph shows up to 12 calendar months. Cyan bars are past months; amber is the current month. New earnings animate the current bar upward.\n\nThe amounts are sales revenue after the store share, before Studio expenses. Current-month revenue and the all-time earned total are separate from the Cash button. Hover for exact cents and paid versus awaiting-settlement amounts.\n\nThe graph stays visible while games are on market. It advances with productive cycles, not real-world waiting."),
			_page("earning", "Earning & settlement", "Sales revenue is earned before it necessarily becomes cash.", "Each release ages as productive cycles pass. Two cycles make a calendar month, and all released games progress on that shared clock.\n\nRevenue is recorded as earned; monthly settlement turns the eligible earned amount into spendable cash. The store share is already accounted for in net revenue and is not deducted a second time.\n\nPer-title age months can differ from calendar months when games launch at different times. Use Monthly Sales for each title and Finances for the combined calendar view."),
			_page("lifespan", "Lifespan & campaigns", "An older game can keep selling, fade to zero, or receive a campaign.", "Organic Awareness changes as a title ages, so monthly sales need not stay at the launch projection. There is no hard expiration: zero-sales titles remain on market.\n\nAn eligible campaign costs $100 and one productive cycle. It temporarily boosts that title's active Awareness for its current age month; it does not permanently lift organic retention.\n\nCampaigns start from release-age month two and must precede that month's first earning cycle. Later repeat campaigns give smaller boosts. Inspect the eligibility message before committing."),
			_page("fans", "Fans & Awareness", "Fans represent an estimated audience for the studio.", "At launch, the current Fan count is frozen for that game's fan-derived Awareness. The current trial contributes one Awareness per four Fans, rounded down, up to 150.\n\nFans are not guaranteed buyers, and copies sold do not identify unique people. The game uses an estimated audience model for growth and loss.\n\nOpen the Fans button to inspect recent monthly changes. New Fans can help future launches; they do not rewrite an earlier launch snapshot."),
			_page("fan_changes", "Growing or losing Fans", "Quality and actual exposure shape monthly audience changes.", "Reviews above 5.0 can recruit Fans through eligible earned sales. Reviews below 5.0 can lose Fans as more of the launch audience is reached. A 5.0 Review is neutral in the current model.\n\nLoss is incremental: the same title does not charge again for exposure already counted. Small calculated changes may round to zero.\n\nSeveral games share one monthly audience boundary. A poor release can matter after launch, but a zero-sales month is not an automatic repeat loss."),
		]),
		_section("finance", "Finances", "Protect the runway for your next productive action.", [
			_page("calendar", "Time & bills", "Two productive cycles make one calendar month.", "Development hands, Research, Contracts and other productive actions advance the shared run calendar. Browsing, sorting and reading help do not.\n\nThe footer shows the date, cycle and next bill. Base rent is $500 each completed month; applicable Traits and hired employees add their own obligations.\n\nReleased games earn as time advances. There is no free Wait button or offline-income clock. Check the next boundary before an action that spends your remaining cash."),
			_page("ledger", "Cash, revenue & profit", "Cash on hand is not the same as monthly profit.", "Open Cash to view Studio Finances. Earned sales are operating revenue; settled sales are actual cash received. Development costs, rent, wages and interest affect expenses.\n\nA loan or startup financing puts cash in the account without being game-sales revenue. Repaying principal reduces cash without being a new operating expense.\n\nCurrent-month rows are partial. Compare the earned, paid and outstanding amounts before deciding what you can afford."),
			_page("arrears", "Unpaid bills", "Old bills keep their original due dates.", "Cash cannot go below zero. Outstanding blocking bills can prevent new spending or productive actions unless the action's genuine receipt or settlement can cover the required obligations.\n\nAutomatic service pays rent first, then payroll, then Bank and education obligations by original due date; Bank wins same-date ties. Debt payments apply due interest before principal.\n\nPartial payment does not make a bill new again or erase late history. Free phase exits and browsing remain distinct from actions that advance a month."),
			_page("bank", "Bank loans & payoff", "Borrow against demonstrated sales, not a launch forecast.", "Open Bank from Finances to see eligibility, available principal and terms. Settled sales and current obligations determine the offer; the credit score does not set eligibility or price. Choose an amount and term, then inspect the full repayment quote.\n\nAn accepted loan adds cash and scheduled installments. It does not count as earned revenue or guarantee an affordable next month.\n\nFor early payoff, inspect the current quote and confirm. Cash must cover the required balance and already-due obligations. Reopening a quote is free; confirmation uses the current valid terms."),
			_page("credit", "Credit & education debt", "Credit follows monthly financial history.", "On-time, profitable months can improve credit. Overdue bills can reduce it; repeatedly opening menus or taking loans does not farm credit.\n\nCollege Dropout and Graduate can add education debt when chosen for a new Studio. They provide Trait points rather than a cash loan deposit. Check the selection's grace period and payment schedule.\n\nFinances shows education balances and payoff terms. Education-only arrears do not block production, but they still affect credit and Bank eligibility."),
		]),
		_section("rivals", "Rivals", "Other studios share the calendar.", [
			_page("competition", "AI competitors", "Your productive actions also advance the rival studios.", "The current trial starts rival studios alongside a new game. They develop and release their own projects as shared time advances.\n\nYour choices still control only your own hands and Studio. Opening this guide or leaving the game paused does not give rivals extra turns.\n\nBeta Insider cards can reveal the competitor snapshot used by the current project. Treat that revealed snapshot as project information, rather than assuming every hidden opponent value is known."),
			_page("market", "Market information", "Use the information the current project actually reveals.", "Insider research can expose a project's market forecast or competitor snapshot. Release summaries show the frozen market context used for its launch.\n\nThe market trial takes one snapshot per calendar month from actual releases in the last 12 cycles. Other studios in your Genre raise future Core targets by up to 4 points; strong releases can raise individual targets by up to 8. The larger lift applies. Targets freeze when your project starts.\n\nSales count Genre-only, Theme-only and matching-pair competitors separately, including your other titles. Each costs 6%, 3% or 12% respectively, with a 70% floor. The factor freezes for both earning halves of a release-age month. Pre-Development, Core target tooltips, Detailed Review and Monthly Sales explain the saved values. Trial values may change after testing.\n\nCompare your own Reviews, costs and sales history when planning. A forecast is useful information, not a promise of cash."),
		]),
		_section("controls", "Controls", "Navigate safely and keep your place.", [
			_page("navigation", "Mouse & keyboard", "Choose folders above, then topics on the left.", "Click a folder or topic to read it. Tab and Shift+Tab move through the guide's controls. Left/Right moves between top folders; Up/Down moves through the topic list. Enter or Space activates a focused button.\n\nScroll long pages with the wheel, the scrollbar, or Page Up / Page Down. Escape closes the guide and restores focus to the button that opened it.\n\nIn play, click cards to select them and inspect the displayed hand before committing. Hover card fields and HUD values for extra detail."),
			_page("pause", "Pause & Settings", "Escape pauses play while the music keeps going at your chosen volume with room reverb.", "Resume continues the current state and returns to the normal music mix. Card animations rejoin the music rhythm. How to Play opens this reference while the game stays paused; closing it returns to Pause. Settings also works while paused.\n\nSettings controls window mode, window size and Master, Music and SFX levels. Display changes require confirmation and can revert if you do not keep them.\n\nMain Menu may ask you to discard work since the last Studio checkpoint. Cancel returns to Pause without losing that work."),
			_page("continue", "Saving & Continue", "Continue restores the last committed Studio checkpoint.", "The game saves at committed Studio boundaries, including supported Studio actions and returns after release or Contract completion.\n\nDevelopment and active Contract hands are not mid-phase saves. Leaving during them discards progress since that checkpoint, including an unsaved Contract advance. Returning to Main Menu explains the rollback before you confirm.\n\nContinue restores the saved state without replaying payouts or earning offline sales. New Run warns before replacing an existing saved Studio."),
			_page("help", "Tips & this guide", "Use short hints in play and the full reference when you need it.", "The footer Tip button explains the current situation. Tutorial opens short context-specific phase tips. This How to Play guide is available from Main Menu and Pause.\n\nBrowsing this reference is free: it does not spend redraws, advance the calendar, change priorities or mark a training challenge complete.\n\nFor exact transaction amounts, use the game's current quote and result screen. This guide explains how to read those choices."),
		]),
	]

static func _section(id: String, label: String, subtitle: String, topics: Array) -> Dictionary:
	return {"id":id,"label":label,"subtitle":subtitle,"topics":topics}

static func _page(id: String, title: String, summary: String, body: String) -> Dictionary:
	return {"id":id,"title":title,"summary":summary,"body":body}

static func _genre_targets() -> String:
	var lines: Array[String] = ["Standards are shown as [b]Graphics / Sound / Technology / Design[/b]. All current Genres total 132, derived from the four-category 33-point baseline.\n"]
	for genre: Dictionary in PrimitivePredevelopment.catalog().genres:
		var targets: Array = PrimitiveReviewCalculator.GENRE_TARGETS[StringName(genre.id)]
		lines.append("[b]%s[/b]  %d / %d / %d / %d" % [genre.name,targets[0],targets[1],targets[2],targets[3]])
	lines.append("\nChoose hands by progress toward your project's standards. These are Review targets, not the percentages you allocate in the priority menu.")
	return "\n".join(lines)

static func _traits() -> String:
	var lines: Array[String] = ["You can choose up to two positive Traits and one negative Trait, within the available point budget. Choosing none is valid. Read both the immediate effect and the long-term cost.\n"]
	for entry: Dictionary in StudioTraits.TRAITS.values():
		lines.append("[b]%s · %s[/b]\n%s\n" % [entry.name,entry.price,entry.description])
	lines.append("Check Overview before confirming. Existing Studios retain the Trait effects under which they were created.")
	return "\n".join(lines)

static func _challenge(kind: StringName) -> String:
	return "\n\n" + ContractChallenges.description(kind) + "\nThe current trial adds up to $100 and 4 Promotion, graded independently of base completion. Missing the challenge never reduces the base reward. Terms freeze when accepted; old completed Contracts receive no retroactive bonus."
