+	while not text.is_empty() and font.get_string_size(text + "...", HORIZONTAL_ALIGNMENT_LEFT, -1, minimum).x > label.size.x:
+		text = text.left(-1)
+	label.text = text + "..."
+	label.set_meta("text_abbreviated", true)
