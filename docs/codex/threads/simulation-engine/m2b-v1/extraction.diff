+	if not CORE_SCORE_BY_STAT.has(card.secondary_stat):
+		return "Card '%s' has an invalid secondary stat: %s" % [card.id, card.secondary_stat]
+	if card.secondary_value < 0:
+		return "Card '%s' has a negative secondary value." % card.id
+	return ""
+
