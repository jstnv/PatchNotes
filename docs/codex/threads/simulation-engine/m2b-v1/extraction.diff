+		&"overview": return _review_signature != _draft_signature()
+	return false
+
+
+func _refresh_attention() -> void:
+	for id: StringName in _folder_buttons:
+		_folder_buttons[id].text = FOLDERS[id] + (" *" if _needs_attention(id) else "")
