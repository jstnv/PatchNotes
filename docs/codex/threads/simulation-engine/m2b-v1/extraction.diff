+			var id := view.get_instance_id()
+			if not _command_view_ids.has(id):
+				_command_view_ids[id] = _command_next_id
+				_command_next_id += 1
+			state.candidate_ids.append(_command_view_ids[id])
+	state.next_candidate_id = _command_next_id
+	return state
