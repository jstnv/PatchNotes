+func sequence(count: int, bonus: bool, frame_step: float) -> void:
+	var motion := HandPresentation.new()
+	var fan := Control.new()
+	root.add_child(fan)
+	root.add_child(motion)
+	motion.set_process(false)
+	fake_time = 63.7 * Grid.STEP # Straddle a loop boundary.
