+static func evaluate(background: StringName, secondary_ids: Array) -> Dictionary:
+	if not BACKGROUNDS.has(background):
+		return {"valid": false, "reason": "Choose exactly one background."}
+	var seen := {}
+	var positive := 0
+	var negative := 0
+	for id: Variant in secondary_ids:
