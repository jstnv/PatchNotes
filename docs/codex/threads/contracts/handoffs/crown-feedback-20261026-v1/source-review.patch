+	_crown_details_modal.show()
+	(_crown_details_modal.get_child(0).find_child("CrownDetailsBack",true,false) as Button).grab_focus()
+
+func _close_crown_details() -> void:
+	_crown_details_modal.hide()
+	(_crown_result_details if _state.is_completed() else _crown_details_button).grab_focus()
+
+func _unhandled_input(event: InputEvent) -> void:
+	if event.is_action_pressed("ui_cancel") and _crown_details_modal.visible:
+		_close_crown_details();get_viewport().set_input_as_handled()
