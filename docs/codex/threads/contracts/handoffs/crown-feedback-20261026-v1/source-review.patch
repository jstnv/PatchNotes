+extends SceneTree
+const Factory=preload("res://scripts/simulation/run_factory.gd")
+const Campaign=preload("res://scripts/simulation/campaign_session.gd")
+const Replay=preload("res://scripts/simulation/development_replay.gd")
+const Feedback=preload("res://scripts/contracts/crown_feedback.gd")
+var checks:=0
+var failures:=0
+func check(ok: bool,label: String) -> void:
+	checks+=1
+	if not ok:failures+=1;push_error("FAIL: "+label)
+func _initialize() -> void:go.call_deferred()
+func go() -> void:
+	var folder:=OS.get_environment("PN_CROWN_OUTPUT")
+	var results:=OS.get_environment("PN_CROWN_RESULTS")
+	var input:=folder.path_join("prefix-run-v1/cases/current-action-4417-cash18/studio_checkpoint.json")
+	for arg in OS.get_cmdline_user_args():
+		if arg.begins_with("--input="):input=arg.trim_prefix("--input=")
+	var envelope: Dictionary=JSON.parse_string(FileAccess.get_file_as_string(input))
+	# Explicit current-rule player DTO hydration, no editing replay/source identities.
+	# A final-source envelope is written below and restored through the strict API.
+	var catalog=root.get_node("CardDatabase").get_development_catalog()
+	var fresh=Factory.create_fresh_session({"schema_version":1,"studio_id":"feedback-check","studio_name":"Feedback","specialty":"action","traits":[],"seed":"4417"},catalog)
+	var run:=StudioCheckpoint.new().hydrate(envelope.studio_payload)
+	check(run!=null,"Unfunded legal two-release player payload validates")
+	if run==null:finish();return
+	var s=Campaign.new();s.run=run;s.catalog=catalog;s.snapshots=fresh.snapshots
+	check(run.get_released_game_ids().size()==2 and run._unlocked_publishers.has(&"crown_quill"),"Actual Review unlock, not a synthetic publisher grant")
+	var tape:=Replay.begin(s)
+	FileAccess.open(results.path_join("initial-current.json"),FileAccess.WRITE).store_string(JSON.stringify(s.export_checkpoint()))
+	for brief in range(3):
+		var q:=run.get_contract_search_quote(&"crown_quill",&"brief")
+		check(not q.is_empty(),"Crown Search available")
+		if q.is_empty():finish();return
+		var bad:=q.duplicate(true);bad.terms.scope=8
+		var initial:=Replay.state(s)
+		check(not run.search_contracts(bad) and Replay.state(s)==initial,"Search request tampering rejected atomically")
+		check(Replay.record(s,tape,s.command(&"search_contracts",{"quote":q})).ok,"Search costs existing productive cycle")
+		var pending:=s.export_checkpoint();var restored=Campaign.new()
+		check(restored.restore_checkpoint(pending,catalog,fresh.snapshots) and Replay.state(restored)==Replay.state(s),"Pending Brief restores exactly")
+		var offer:=run.get_crown_brief_offer()
+		check(Replay.record(s,tape,s.command(&"accept_contract",{"kind":&"crown_brief","offer_id":offer.offer_id,"quote":offer})).ok,"Accept paid-search Brief")
+		check(Replay.record(s,tape,s.command(&"contract",{"request":s.contract.command(&"begin")})).ok,"Deal current seven cards")
+		for hand in range(2):
+			var before:=Replay.state(s)
+			var ids: Array=s.contract.candidate_ids.slice(0,4)
+			var value:=Feedback.query(s.contract,run,ids)
+			check(value.available and not value.selected.is_empty(),"Legal selected projection available")
+			if value.selected.is_empty():finish();return
+			check(value.selected.final==(hand==1),"First hand provisional; final hand completion")
+			check(value.legal_choices==0 if hand==0 else value.legal_choices>0,"Only final-hand current choices enumerated")
+			check(value.warning.is_empty() if hand==0 else true,"No first-hand all-zero warning")
+			if hand==1:
+				# Constructed zero-choice fixture, restored before any live command.
+				var saved_cores: Dictionary=s.contract._state._core_half_units.duplicate()
+				s.contract._state._core_half_units[0]=10000
+				var zero:=Feedback.query(s.contract,run,ids)
+				check(zero.available and zero.legal_choices==35 and zero.warning==Feedback.ALL_ZERO,"All35 final choices with zero requested award warn")
+				s.contract._state._core_half_units=saved_cores
+				check(Feedback.query(s.contract,run,ids).selected==value.selected,"Score change invalidates and restoration restores exact quote")
+			for n in range(4):Feedback.query(s.contract,run,ids)
+			check(Replay.state(s)==before,"Repeated selected/warning/history queries preserve all state and RNG")
+			var stale:=Feedback.identity(s.contract,run)
+			check(Feedback.query(s.contract,run,[ids[0],ids[0],ids[2],ids[3]]).selected.is_empty(),"Duplicate current tokens unavailable")
+			check(Feedback.query(s.contract,run,[ids[0],ids[1],ids[2],-1]).selected.is_empty(),"Unknown token unavailable")
+			check(not Feedback.query(s.contract,run,ids,false).available,"Incoherent presentation suppresses query")
+			check(not Feedback.query(s.contract,run,ids,true,"stale").available,"Stale identity unavailable")
+			if hand==0:
+				var old:=ids.duplicate()
+				check(Replay.record(s,tape,s.command(&"contract",{"request":s.contract.command(&"redraw",{"candidate_ids":[ids[0]]})})).ok,"Ordinary redraw retained")
+				check(not Feedback.query(s.contract,run,old,true,stale).available,"Redraw invalidates old projection identity")
+				check(Feedback.query(s.contract,run,old).selected.is_empty(),"Retired candidate token is not reusable")
+				ids=s.contract.candidate_ids.slice(0,4)
+				value=Feedback.query(s.contract,run,ids)
+			var rep: int=run.get_publisher_relationships()[&"crown_quill"].reputation_bp
+			var request:=s.command(&"contract",{"request":s.contract.command(&"play",{"candidate_ids":ids})})
+			run.checkpoint_mutations_allowed=false
+			var locked:=Replay.state(s)
+			check(not s.execute(request).ok and Replay.state(s)==locked,"Blocked save guard preserves hand, finance, standing and RNG")
+			run.checkpoint_mutations_allowed=true
+			check(Replay.record(s,tape,request).ok,"Commit revalidates normal hand")
+			if hand==0:check(run.get_publisher_relationships()[&"crown_quill"].reputation_bp==rep,"Provisional quote never credits standing")
+			else:
+				var completed:=Feedback.completed(run,s.contract._state)
+				check(not completed.is_empty() and completed.requested_bp==value.selected.requested_bp and completed.credited_bp==value.selected.credited_bp,"Trusted committed event equals final projection")
+				var done:=Replay.state(s)
+				check(not s.execute(request).ok and Replay.state(s)==done,"Duplicate settlement rejected without state/RNG changes")
+				check(not Feedback.query(s.contract,run,ids).available,"Completed state cannot keep selected preview")
+		check(Replay.record(s,tape,s.command(&"dismiss_contract")).ok,"Dismiss returns to Studio")
+		var saved:=s.export_checkpoint();var cold=Campaign.new()
+		check(not saved.is_empty() and cold.restore_checkpoint(saved,catalog,fresh.snapshots) and Replay.state(cold)==Replay.state(s),"Completed ledger cold-restores exactly")
+		check(Feedback.history(cold.run)==Feedback.history(run),"Derived history survives Continue without durable streak")
+		if brief==2:
+			FileAccess.open(results.path_join("completed-current.json"),FileAccess.WRITE).store_string(JSON.stringify(saved))
+	check(Replay.save_tape(results.path_join("feedback-tape.json"),tape),"Typed tape writer preserves integer/token/RNG types")
+	var history_before:=run._publisher_relationships.duplicate(true)
+	var completed_ids:=run._crown_briefs.keys()
+	var missing: Variant=run._publisher_relationships.events.pop_back()
+	check(not Feedback.history(run).available,"Missing committed completion makes history unavailable")
+	run._publisher_relationships=history_before
+	check(Feedback.history(run).available,"Restored full ledger valid")
+	var stats: Array=[]
+	for id in completed_ids:
+		var f:=Feedback.completed(run,run._crown_briefs[id].state)
+		stats.append({"requested_bp":f.requested_bp,"credited_bp":f.credited_bp,"scope":f.scope,"cores":f.cores})
+	FileAccess.open(results.path_join("flow-results.json"),FileAccess.WRITE).store_string(JSON.stringify({"checks":checks,"failures":failures,"source":Replay.source_identity(),"briefs":stats,"history":Feedback.history(run)},"\t"))
+	finish()
+func finish() -> void:
+	print("CROWN_FEEDBACK_FLOW checks=%d failures=%d"%[checks,failures]);quit(1 if failures else 0)
