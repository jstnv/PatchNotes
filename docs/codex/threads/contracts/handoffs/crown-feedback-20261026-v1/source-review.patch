+		_crown_feedback_key=key
+	var value: Dictionary=_crown_feedback_value.get("selected",{})
+	_crown_summary.text=CrownFeedback.summary(value)
+	if not value.is_empty() and not value.final:
+		_crown_summary.text=_crown_summary.text.replace("\nOne hand remains."," · One hand remains.")
+	_crown_warning.text=_crown_feedback_value.get("warning","")
+	_crown_warning.visible=not _crown_warning.text.is_empty()
+	_crown_details_button.disabled=value.is_empty()
+	if not _crown_feedback_value.get("available",false):_crown_summary.text="Grade preview unavailable."
+
+func _open_crown_details() -> void:
+	if hand_motion.busy or hand_motion.capturing:return
+	var value: Dictionary=CrownFeedback.completed(_run,_state) if _state.is_completed() else _crown_feedback_value.get("selected",{})
+	if value.is_empty():return
