+## Public policy/menu facts omit mechanical RNG and unresolved Design searches.
+func get_employee_observation() -> Dictionary:
+	var result:=get_employees()
+	result.erase("events")
+	for employee: Dictionary in result.get("employees",{}).values():
+		if employee.type==&"qa":
