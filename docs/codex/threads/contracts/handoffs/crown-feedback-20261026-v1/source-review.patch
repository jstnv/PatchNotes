+## Private Crown Brief presentation queries. No writes, settlement or RNG.
+extends RefCounted
+const Crown := preload("res://scripts/contracts/crown_relationship_rules.gd")
+const Ledger := preload("res://scripts/contracts/publisher_relationships.gd")
+const NAMES := ["Graphics","Sound","Technology","Design"]
+const ALL_ZERO := "With these cards, every four-card selection earns 0.00 Reputation."
+
+static func score(scope: int, cores: Dictionary, terms: Dictionary, standing: int) -> Dictionary:
+	if standing<0 or standing>10000 or terms!=ContractChallenges.terms_for_contract(ContractDefinitions.CROWN_BRIEF): return {}
+	var completion := ContractDefinitions.evaluate(ContractDefinitions.CROWN_BRIEF,scope,cores,-1,0)
+	var balance := ContractChallenges.reward(terms,scope,cores,0)
+	if completion.is_empty() or balance.is_empty(): return {}
+	var completion_bp: int=10000*int(completion.numerator)/int(completion.denominator)
+	var grade: int=mini(completion_bp,int(balance.grade_bp))
+	var requested: int=1000*grade/10000
+	var credited: int=mini(requested,10000-standing)
+	var highest: Array[int]=[]
+	var lowest: Array[int]=[]
+	var maximum: int=cores.values().max()
+	var minimum: int=cores.values().min()
+	for i in range(4):
+		if cores[i]==maximum:highest.append(i)
+		if cores[i]==minimum:lowest.append(i)
+	var reason := "Full grade at these scores."
+	if int(balance.grade_bp)==0: reason="Core balance is 0% at this spread."
+	elif int(balance.grade_bp)<completion_bp: reason="Core spread limits the grade."
+	elif completion_bp<int(balance.grade_bp): reason="Work completion limits the grade."
+	elif grade<10000: reason="Work completion and Core balance both limit the grade."
+	return {"scope":scope,"cores":cores.duplicate(),"completion_bp":completion_bp,"balance_bp":int(balance.grade_bp),
+		"grade_bp":grade,"requested_bp":requested,"credited_bp":credited,"standing_before":standing,
+		"standing_after":standing+credited,"cap_limited":credited<requested,"spread_half":maximum-minimum,
+		"highest":highest,"lowest":lowest,"reason":reason}
+
+static func summarize(ledger: Dictionary, owner: StringName, cycle: int, resolver: Callable, completed: Array) -> Dictionary:
+	var totals := Ledger.reconstruct(ledger,owner,cycle,resolver)
+	if totals.is_empty(): return {"available":false}
+	var seen := {}
+	var count := 0
+	for event: Dictionary in ledger.events:
+		if event.publisher_id!=&"crown_quill" or event.kind!=Crown.KIND: continue
+		if event.source_id not in completed or seen.has(event.source_id):return {"available":false}
+		seen[event.source_id]=true
+		count=count+1 if event.requested_reputation_bp==0 else 0
+	if seen.size()!=completed.size():return {"available":false}
+	var at_cap: bool=totals[&"crown_quill"].reputation_bp>=10000
+	return {"available":true,"count":count,"remind":count>=2 and not at_cap,"at_cap":at_cap}
+
+static func history(run: RunState) -> Dictionary:
+	if run==null:return {"available":false}
+	var completed: Array=[]
+	for id: StringName in run._crown_briefs:
+		var offer: Dictionary=run._crown_briefs[id]
+		if not offer.get("state") is ContractState:continue
+		if offer.state.is_completed():
+			if Crown.facts(run,id).is_empty():return {"available":false}
+			completed.append(id)
+	if not run._crown_briefs.is_empty() and not RunState.ContractSearch.valid(RunState.ContractSearch.data(run)):return {"available":false}
+	var resolver := func(request: Dictionary) -> Dictionary:return RunState.RelationshipRules.resolve(run,request)
+	return summarize(run._publisher_relationships,run._bank_run_id,run.get_completed_run_cycles(),resolver,completed)
+
+static func reminder(summary: Dictionary, proactive: bool=true) -> String:
+	if not summary.get("available",false):return "Crown Brief history unavailable."
+	if int(summary.count)<2:return ""
+	var factual := "Last %d Crown Briefs: 0.00 Reputation earned."%summary.count
+	return factual+" Check Work completion and Core balance before your next Brief." if proactive and summary.remind else factual
+
+static func identity(session: RefCounted, run: RunState) -> String:
+	if session==null or run==null or session._state==null:return ""
+	var s: ContractState=session._state
+	var cards: Array=[]
+	for card: CardData in session.cards:
+		if card==null:return ""
+		cards.append([card.id,card.card_type,card.phase,card.renewable,card.primary_stat,card.primary_value,card.secondary_stat,card.secondary_value,card.scope])
+	return JSON.stringify([s.get_contract_id(),s.get_offer_id(),s.get_source_release_id(),s.get_successful_hand_count(),
+		s.get_scope(),s._core_half_units,s.get_challenge_terms(),s.get_challenge_redraws(),s.get_exhausted_feature_ids(),
+		s.get_eligible_feature_ids(),s.get_priority_distribution(),s.is_upfront_committed(),s.is_completed(),
+		session.sequence,session.candidate_ids,cards,run.get_completed_run_cycles(),run.get_available_redraws(),run.get_cash_cents(),
+		run._studio_finance.actions.size(),run._publisher_relationships,run._contract_search,run.checkpoint_mutations_allowed]).sha256_text()
+
+static func query(session: RefCounted, run: RunState, selected: Array, coherent: bool=true, expected: String="") -> Dictionary:
+	var unavailable := {"available":false,"warning":"","selected":{}}
+	if not coherent or session==null or run==null or session._state==null:return unavailable
+	var s: ContractState=session._state
+	if s.get_contract_id()!=ContractDefinitions.CROWN_BRIEF or s.is_completed() or run.get_active_contract()!=s or not run.owns_contract_state(s):return unavailable
+	if s.get_challenge_terms()!=ContractChallenges.terms_for_contract(ContractDefinitions.CROWN_BRIEF) or not session.valid_pool():return unavailable
+	if not expected.is_empty() and expected!=identity(session,run):return unavailable
+	var source := RunState.ContractSearch.source(run,s.get_offer_id(),&"brief",&"crown_quill")
+	var past := history(run)
+	if source.is_empty() or not past.available:return unavailable
+	var standing: Dictionary=run.get_publisher_relationships()
+	if standing.is_empty():return unavailable
+	var rep: int=standing[&"crown_quill"].reputation_bp
+	var result := {"available":true,"warning":"","selected":{},"history":past,"legal_choices":0,"final":s.get_successful_hand_count()==1}
+	# Current cards only; do not predict first-hand future draws.
+	if result.final:
+		var all_zero := true
+		for a in range(session.cards.size()-3):
+			for b in range(a+1,session.cards.size()-2):
+				for c in range(b+1,session.cards.size()-1):
+					for d in range(c+1,session.cards.size()):
+						var quartet: Array[CardData]=[session.cards[a],session.cards[b],session.cards[c],session.cards[d]]
+						var p: Dictionary=s.plan_hand(quartet)
+						if p.is_empty():continue
+						result.legal_choices+=1
+						var value := projected(s,p,rep)
+						if value.is_empty():return unavailable
+						if value.requested_bp>0:all_zero=false
+		if result.legal_choices>0 and all_zero:result.warning=ALL_ZERO
+	if selected.size()!=4:return result
+	var seen := {}
+	var cards: Array[CardData]=[]
+	for token in selected:
+		if not token is int or token not in session.candidate_ids or seen.has(token):return result
+		seen[token]=true
+		cards.append(session.cards[session.candidate_ids.find(token)])
+	var plan: Dictionary=s.plan_hand(cards)
+	if plan.is_empty():return result
+	result.selected=projected(s,plan,rep)
+	if result.selected.is_empty():return unavailable
+	result.selected.final=bool(result.final)
+	result.selected.finance_ok=run.can_complete_productive_cycle(int(plan.remainder_cents))
+	return result
+
+static func projected(state: ContractState, plan: Dictionary, standing: int) -> Dictionary:
+	var cores := {}
+	for i in range(4):cores[i]=state.get_core_score_half_units(i)+int(plan.score_additions[i])
+	return score(state.get_scope()+int(plan.scope_addition),cores,state.get_challenge_terms(),standing)
+
+static func completed(run: RunState, state: ContractState) -> Dictionary:
+	if run==null or state==null or state.get_contract_id()!=ContractDefinitions.CROWN_BRIEF or not state.is_completed():return {}
+	var past := history(run)
+	if not past.available or Crown.facts(run,state.get_offer_id()).is_empty():return {}
+	for event: Dictionary in run._publisher_relationships.events:
+		if event.publisher_id!=&"crown_quill" or event.kind!=Crown.KIND or event.source_id!=state.get_offer_id():continue
+		var standing_before := 0
+		for earlier: Dictionary in run._publisher_relationships.events:
+			if earlier.ordinal>=event.ordinal:break
+			if earlier.publisher_id==&"crown_quill":standing_before+=int(earlier.credited_reputation_bp)
+		var cores := {}
+		for i in range(4):cores[i]=state.get_core_score_half_units(i)
+		var value := score(state.get_scope(),cores,state.get_challenge_terms(),standing_before)
+		if value.is_empty() or value.requested_bp!=event.requested_reputation_bp or value.credited_bp!=event.credited_reputation_bp:return {}
+		value.history=past
+		return value
+	return {}
+
+static func half(value: int) -> String:
+	return str(value/2) if value%2==0 else "%d.5"%(value/2)
+
+static func summary(value: Dictionary, done: bool=false) -> String:
+	if value.is_empty():return "Select four cards to preview this hand."
+	var text := "Work completion %.2f%% · Core balance %.2f%%\n"%[value.completion_bp/100.0,value.balance_bp/100.0]
+	if done:text+="Brief complete · Crown Reputation added: +%.2f"%[value.credited_bp/100.0]
+	elif value.get("final",false):text+="On completion: +%.2f Crown Reputation · Standing %.2f → %.2f"%[value.credited_bp/100.0,value.standing_before/100.0,value.standing_after/100.0]
+	else:text+="Current score value: +%.2f Reputation\nOne hand remains. This value can rise or fall. No award yet."%[value.requested_bp/100.0]
+	return text
+
+static func details(value: Dictionary) -> String:
+	if value.is_empty():return ""
+	var values: Array[String]=[]
+	for i in range(4):values.append("%s %s / 4"%[NAMES[i],half(value.cores[i])])
+	var high: Array[String]=[];var low: Array[String]=[]
+	for i in value.highest:high.append(NAMES[i])
+	for i in value.lowest:low.append(NAMES[i])
+	var text := "Scope %d / 9\n%s\n%s\nThe lower of Work completion and Core balance sets the grade.\nHighest: %s · Lowest: %s · Spread: %s\nFull Core balance at spread ≤2; zero at ≥6.\nGrade value: +%.2f; Added on completion: +%.2f (cap 100)."%[
+		value.scope," · ".join(values),value.reason,", ".join(high),", ".join(low),half(value.spread_half),value.requested_bp/100.0,value.credited_bp/100.0]
+	if value.standing_before>=10000:text+="\nCrown Reputation is at 100."
+	elif value.cap_limited:text+="\nThe Reputation cap limits the credited award."
+	if value.has("history"):
+		var history_text := reminder(value.history,false)
+		if not history_text.is_empty():text+="\n"+history_text
+	return text
