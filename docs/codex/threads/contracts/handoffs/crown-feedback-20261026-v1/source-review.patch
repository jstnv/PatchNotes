+			return {"offer_id":offer.offer_id,"publisher_id":PublisherCatalog.SIDESTREET,
+				"source_release_id":offer.source_release_id,"required_hands":2,
+				"cash_cents":0,"advance_cents":0,"promotion":0}
+	return {}
