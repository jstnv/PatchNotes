+func _refresh_crown_feedback() -> void:
+	if _crown_row==null:return
+	_crown_row.visible=_state!=null and _state.get_contract_id()==ContractDefinitions.CROWN_BRIEF and not _state.is_completed()
+	if not _crown_row.visible:return
