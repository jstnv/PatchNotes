+			if not payload.get(field) is String and not payload.get(field) is StringName: return reject("Missing project choice")
+		var priorities: Variant = payload.get("priorities",{})
+		if not priorities is Dictionary or (not priorities.is_empty() and not PriorityAllocation.is_valid_distribution(priorities)) or not payload.get("commission_quote",{}) is Dictionary or payload.size() != 3 + int(payload.has("priorities")) + int(payload.has("commission_quote")): return reject("Invalid priorities or project payload")
+		var result := BeginProject.execute(run,snapshots,str(payload.name),StringName(payload.genre),StringName(payload.theme),Callable(),[],payload.get("commission_quote",{}))
+		if not result.ok: return reject(result.error)
