+func hydrate(payload: Dictionary, active_rival: bool = false) -> RunState:
+	if payload.get("content_revision", "") != revision():
+		var prior_market: RefCounted=load("res://scripts/market/publisher_brief_save_migration.gd").new()
+		if prior_market.is_prior_market_revision(str(payload.get("content_revision",""))):
