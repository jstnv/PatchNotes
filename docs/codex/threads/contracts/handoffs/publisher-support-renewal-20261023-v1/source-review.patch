+class_name PublisherCommissionTrial
+extends RefCounted
+
+## Private SideStreet tier-1 game-deal trial. These values remain proposed.
+const TERMS_VERSION := 1
+const GATE_BP := 2000
+const FULL_FEE_CENTS := 600000
+const REVIEW_TARGET_TENTHS := 60
+const FULL_AWARD_BP := 1500
+
+static func grade(required_scope: int, delivered_scope: int, review_tenths: int) -> Dictionary:
+	if required_scope <= 0 or delivered_scope < 0 or review_tenths < 0 or review_tenths > 100:
+		return {}
+	var scope_bp: int = clampi(int(10000 * delivered_scope / required_scope), 0, 10000)
+	var review_bp: int = clampi(500 * (review_tenths - (REVIEW_TARGET_TENTHS - 20)), 0, 10000)
+	var delivery_bp: int = mini(scope_bp, review_bp)
+	return {"scope_bp":scope_bp,"review_bp":review_bp,"delivery_bp":delivery_bp,
+		"fee_paid_cents":int(FULL_FEE_CENTS * delivery_bp / 10000),
+		"relationship_award_bp":FULL_AWARD_BP if delivery_bp == 10000 else 0}
+
+static func valid_terms(terms: Dictionary) -> bool:
+	return terms.size() == 10 and terms.get("terms_version") == TERMS_VERSION \
+		and terms.get("publisher_id") == PublisherCatalog.SIDESTREET \
+		and terms.get("fee_cents") == FULL_FEE_CENTS \
+		and terms.get("review_target_tenths") == REVIEW_TARGET_TENTHS \
+		and typeof(terms.get("required_scope")) == TYPE_INT and terms.required_scope > 0 \
+		and typeof(terms.get("quote_id")) == TYPE_STRING_NAME and not terms.quote_id.is_empty() \
+		and typeof(terms.get("project_id")) == TYPE_STRING_NAME and not terms.project_id.is_empty() \
+		and typeof(terms.get("source_release_id")) == TYPE_STRING_NAME and not terms.source_release_id.is_empty() \
+		and typeof(terms.get("accept_cycle")) == TYPE_INT and terms.accept_cycle >= 0 \
+		and terms.get("owner") == &"publisher"
+
+static func valid_result(result: Dictionary, terms: Dictionary) -> bool:
+	if not valid_terms(terms): return false
+	if result.size() != 9 or result.get("release_id") != terms.project_id or result.get("quote_id") != terms.quote_id:
+		return false
+	if typeof(result.get("review_tenths")) != TYPE_INT or typeof(result.get("delivered_scope")) != TYPE_INT:
+		return false
+	var expected := grade(terms.required_scope, result.delivered_scope, result.review_tenths)
+	if expected.is_empty(): return false
+	for key: String in expected:
+		if result.get(key) != expected[key]: return false
+	return true
