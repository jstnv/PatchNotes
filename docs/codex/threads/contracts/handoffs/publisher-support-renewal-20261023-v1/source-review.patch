+			check(not recaptured.is_empty(), "Upgraded Studio re-saves")
+			if not recaptured.is_empty():
+				check(recaptured.run == updated.run and recaptured.rng == before.rng, "Old state and RNG preserve exact values on re-save")
+		var prior_native := old._decode_payload(before)
+		var current_native := adapter._decode_payload(updated)
+		for key: String in prior_native:
+			if key == "content_revision": continue
+			if key == "run":
+				for field: String in prior_native.run:
+					check(prior_native.run[field] == current_native.run[field], "Unchanged old run field " + field)
