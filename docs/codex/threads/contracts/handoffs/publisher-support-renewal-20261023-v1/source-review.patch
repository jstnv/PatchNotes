+extends RefCounted
+
+const OldStudio := preload("res://scripts/market/legacy_publisher_brief_studio_validator.gd")
+const PRIOR_BRIEF_REVISION := "a4285194b465dd907e8f904ec3dff37796d1689e664a9aebe4c36d7dbc8095ab"
+
+var error := ""
+
+static func is_prior_brief_revision(revision_id: String) -> bool:
+	return revision_id == PRIOR_BRIEF_REVISION and OldStudio.new().revision() == PRIOR_BRIEF_REVISION
+
+func upgrade_player(payload: Dictionary, active_rival: bool = false) -> Dictionary:
+	error = ""
+	if payload.has("rival_world"):
+		error = "Rival world must be migrated with its player"
