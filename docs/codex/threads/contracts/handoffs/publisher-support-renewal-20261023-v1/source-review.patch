+		error = "Unknown prior Brief Studio source"
+		return {}
+	var old_adapter := OldStudio.new()
+	var reason: String = old_adapter.validate_active_rival(payload) if active_rival else old_adapter.validate(payload)
+	if not reason.is_empty():
+		error = "Invalid original Brief Studio: " + reason
+		return {}
+	var native: Dictionary = old_adapter._decode_payload(payload, active_rival)
+	if native.is_empty():
+		error = "Original Brief Studio decode: " + old_adapter.error
+		return {}
+	if native.run.has("publisher_investment_capacity_bp") or native.run.has("commission_deals") or native.run.has("commission_events"):
+		error = "Mixed prior/current commission fields"
+		return {}
+	native.run.publisher_investment_capacity_bp = {}
+	native.run.commission_deals = {}
+	native.run.commission_events = {}
+	native.content_revision = LegacyPublisherCommissionStudioValidator.new().revision()
+	var codec := CheckpointCodec.new()
+	var upgraded: Variant = codec.encode(native, LegacyPublisherCommissionSchema.root(true, active_rival))
+	if not codec.error.is_empty() or not upgraded is Dictionary:
+		error = "Upgraded Brief Studio encoding: " + codec.error
+		return {}
+	var current := LegacyPublisherCommissionStudioValidator.new()
+	reason = current.validate_active_rival(upgraded) if active_rival else current.validate(upgraded)
+	if not reason.is_empty():
+		error = "Upgraded Brief Studio validation: " + reason
+		return {}
+	return upgraded
