+			# identity when it becomes a supported historical revision.
+			if rules in [RULES, PRE_MARKET_RULES, PRE_ROSTER_RULES, PRE_GAMEPLAY_TREE_RULES, PRE_CONE_RULES, PRE_CHALLENGE_RULES, PRE_BRANCH_RULES, PRE_CULT20_RULES]: continue
