+	check(Migration.new().upgrade_player(malformed).is_empty(), "Corrupt old finance rejects")
+	malformed = before.duplicate(true)
+	malformed.content_revision = "unknown-prior-market"
+	check(Migration.new().upgrade_player(malformed).is_empty(), "Unknown revision rejects")
+	malformed = before.duplicate(true)
+	malformed.source_build = "unknown-source"
+	check(Migration.new().upgrade_player(malformed).is_empty(), "Unknown source build rejects")
+	malformed = before.duplicate(true)
+	malformed.rival_world = {}
+	check(Migration.new().upgrade_player(malformed).is_empty(), "World cannot be silently dropped")
