+			var actual_upgraded: Dictionary = Migration.new().upgrade_player(actual)
+			check(not actual_upgraded.is_empty(), "Actual old Studio upgrades")
+			if not actual_upgraded.is_empty():
+				var adapter := StudioCheckpoint.new()
+				check(adapter.validate(actual_upgraded).is_empty(), "Actual old Studio validates after migration")
+				var restored := adapter.hydrate(actual)
+				check(restored != null, "Actual old Studio hydrates through candidate adapter")
+				if restored != null:
+					check(restored._sidestreet_briefs.is_empty() and restored._publisher_reputation_bp.is_empty(), "Actual old Studio gets no invented Brief or Reputation")
+					check(adapter.capture(restored).rng == actual.rng, "Actual old RNG survives capture")
+				var actual_native := old._decode_payload(actual)
+				var upgraded_native := adapter._decode_payload(actual_upgraded)
+				for field: String in actual_native.run:
+					check(actual_native.run[field] == upgraded_native.run[field], "Actual old field " + field + " unchanged")
+	print("PRIOR_MARKET_PUBLISHER_MIGRATION checks=%d failures=%d old_revision=%s current_revision=%s" % [checks, failures, before.get("content_revision", ""), StudioCheckpoint.new().revision()])
+	quit(0 if failures == 0 else 1)
