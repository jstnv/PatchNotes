+## Additive migration for the exact -market1 Studio revision captured when this
+## private variant was created. Original encoded fields are authenticated by
+## the frozen base validator/schema before any new field is supplied.
+extends RefCounted
+
+const OldStudio := preload("res://scripts/market/legacy_market_studio_validator.gd")
+const PRIOR_MARKET_REVISION := "f522bf2f8166cba5fa68cb9936c04ef0b64d46560d5e68cca9681733e1fa7f0b"
+
+var error := ""
+
+static func is_prior_market_revision(revision_id: String) -> bool:
+	# A changed data catalog must not silently redefine which prior save is
+	# accepted under the preserved validator.
+	return revision_id == PRIOR_MARKET_REVISION and OldStudio.new().revision() == PRIOR_MARKET_REVISION
+
+func upgrade_player(payload: Dictionary, active_rival: bool = false) -> Dictionary:
+	error = ""
+	if payload.has("rival_world"):
+		error = "Rival world must be migrated with its player"
+		return {}
+	if not is_prior_market_revision(str(payload.get("content_revision", ""))) or payload.get("source_build") != OldStudio.BUILD:
+		error = "Unknown prior market Studio source"
+		return {}
+	var old_adapter := OldStudio.new()
+	var reason: String = old_adapter.validate_active_rival(payload) if active_rival else old_adapter.validate(payload)
+	if not reason.is_empty():
+		error = "Invalid original market Studio: " + reason
+		return {}
+	var native: Dictionary = old_adapter._decode_payload(payload, active_rival)
+	if native.is_empty():
+		error = "Original market Studio decode: " + old_adapter.error
+		return {}
+	if native.run.has("sidestreet_briefs") or native.run.has("publisher_reputation_bp") or native.run.has("publisher_reputation_events"):
+		error = "Mixed prior/current publisher fields"
+		return {}
+	native.run.sidestreet_briefs = {}
+	native.run.publisher_reputation_bp = {}
+	native.run.publisher_reputation_events = {}
+	native.run.publisher_investment_capacity_bp = {}
+	native.run.commission_deals = {}
+	native.run.commission_events = {}
+	native.run.support_deals = {}
+	native.run.support_rights = {}
+	native.run.support_events = {}
+	native.run.studio_finance = StudioFinanceLedger.upgrade_commission_journal(native.run.studio_finance)
