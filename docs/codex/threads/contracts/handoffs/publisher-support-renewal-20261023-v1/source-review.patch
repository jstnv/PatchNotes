+const LEGACY_AUDIO_HASHES := ["56545f71a914d244952925813e71aeca3584e07ce36ddcbfbe07a15749ef1cf3", "66dcfcc25c7da4e974750353a4f192a89507563ffc7854c591bd21c9ddf25d78"]
