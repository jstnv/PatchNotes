+		check(not active_after.is_empty(), "Active-rival Studio upgrades")
+		if not active_after.is_empty():
+			check(StudioCheckpoint.new().validate_active_rival(active_after).is_empty(), "Upgraded active-rival Studio validates")
+			check(StudioCheckpoint.new().hydrate(active_before, true) != null, "Original active-rival Studio hydrates")
+			check(active_after.active_project_id == active_before.active_project_id and active_after.rng == active_before.rng, "Active project and RNG unchanged")
+	var frame_path := OS.get_environment("PN_PRIOR_MARKET_FRAME")
+	if not frame_path.is_empty():
+		var frame: Variant = JSON.parse_string(FileAccess.get_file_as_string(frame_path))
