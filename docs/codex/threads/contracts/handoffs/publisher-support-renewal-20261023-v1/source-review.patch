@@ -0,0 +1,92 @@
+class_name PublisherSupportTrial
+extends RefCounted
+
+## Contracts-owned private candidate. The accepted values remain PROPOSED.
+const TERMS_VERSION := 2
+const GATE_BP := 1500
+const NEXT_STEP_BP := 1000
+const CASH_SHARE_BP := 8000
+const RECOUP_SHARE_BP := 2000
+const REVIEW_TARGET_TENTHS := 70
+const MONTH3_UNITS_TARGET := 1000
+const OBSERVE_EARNING_CYCLE := 6
+const RECOUP_CUTOFF_CYCLE := 24
+const MARKETING_CENTS_PER_POINT := 3500
+const MAX_BUDGET_CENTS := 300000
+
+static func quote_amounts(investment_bp: int) -> Dictionary:
+	if investment_bp < GATE_BP or investment_bp > 10000: return {}
+	var budget: int = mini(MAX_BUDGET_CENTS, 50000 + 2500 * (investment_bp / 100))
+	var raw_cash: int = budget * CASH_SHARE_BP / 10000
+	var points: int = (budget - raw_cash) / MARKETING_CENTS_PER_POINT
+	return {"support_budget_cents":budget,"funding_cents":budget - points * MARKETING_CENTS_PER_POINT,"marketing_points":points}
+
+static func valid_terms(terms: Dictionary) -> bool:
+	if terms.size() != 18 or terms.get("terms_version") != TERMS_VERSION or terms.get("publisher_id") != PublisherCatalog.SIDESTREET or terms.get("owner") != &"studio": return false
+	for key: String in ["acceptance_investment_bp","support_budget_cents","funding_cents","marketing_points","recoup_share_bp","recoup_cutoff_cycle","review_target_tenths","month3_units_target","observe_earning_cycle","accept_cycle"]:
+		if typeof(terms.get(key)) != TYPE_INT or terms[key] < 0: return false
+	for key: String in ["quote_id","project_id","source_release_id"]:
+		if typeof(terms.get(key)) != TYPE_STRING_NAME or terms[key].is_empty(): return false
+	for key: String in ["previous_support_id","qualification_event_id"]:
+		if typeof(terms.get(key)) != TYPE_STRING_NAME: return false
+	if terms.previous_support_id.is_empty() != terms.qualification_event_id.is_empty(): return false
+	var amounts := quote_amounts(terms.acceptance_investment_bp)
+	return not amounts.is_empty() and terms.support_budget_cents == amounts.support_budget_cents and terms.funding_cents == amounts.funding_cents and terms.marketing_points == amounts.marketing_points and terms.recoup_share_bp == RECOUP_SHARE_BP and terms.recoup_cutoff_cycle == RECOUP_CUTOFF_CYCLE and terms.review_target_tenths == REVIEW_TARGET_TENTHS and terms.month3_units_target == MONTH3_UNITS_TARGET and terms.observe_earning_cycle == OBSERVE_EARNING_CYCLE
+
+static func initial_rights(terms: Dictionary) -> Dictionary:
+	if not valid_terms(terms): return {}
+	return {"quote_id":terms.quote_id,"raw_net_cents":0,"publisher_recoup_cents":0,"studio_earned_cents":0,"studio_settled_cents":0,"earning_cycles":0}
+
+static func next_rights(terms: Dictionary, old: Dictionary, old_sales: Dictionary, next_sales: Dictionary, crosses_month: bool) -> Dictionary:
+	if not valid_terms(terms) or not valid_rights(terms,old,old_sales) or next_sales.get("total_earned_cycles",-1) != old.earning_cycles+1 or not ReleasedGameSales.is_valid(next_sales): return {}
+	var raw: int = int(next_sales.entitlement_cents)
+	if raw < int(old.raw_net_cents): return {}
+	var recoup: int = int(old.publisher_recoup_cents)
+	if next_sales.total_earned_cycles <= terms.recoup_cutoff_cycle:
+		recoup = mini(int(terms.support_budget_cents),raw*int(terms.recoup_share_bp)/10000)
+	if recoup < int(old.publisher_recoup_cents) or recoup > raw: return {}
+	var earned: int = raw-recoup
+	if earned < int(old.studio_earned_cents): return {}
+	var settled: int = earned if crosses_month else int(old.studio_settled_cents)
+	if settled < int(old.studio_settled_cents) or settled > earned: return {}
+	return {"quote_id":terms.quote_id,"raw_net_cents":raw,"publisher_recoup_cents":recoup,"studio_earned_cents":earned,"studio_settled_cents":settled,"earning_cycles":int(next_sales.total_earned_cycles)}
+
+static func valid_rights(terms: Dictionary, rights: Dictionary, sales: Dictionary) -> bool:
+	if not valid_terms(terms) or rights.size() != 6 or not ReleasedGameSales.is_valid(sales) or rights.get("quote_id") != terms.quote_id: return false
+	for key: String in ["raw_net_cents","publisher_recoup_cents","studio_earned_cents","studio_settled_cents","earning_cycles"]:
+		if typeof(rights.get(key)) != TYPE_INT or rights[key] < 0: return false
+	if rights.raw_net_cents != sales.entitlement_cents or rights.earning_cycles != sales.total_earned_cycles or rights.publisher_recoup_cents > terms.support_budget_cents or rights.studio_earned_cents != rights.raw_net_cents-rights.publisher_recoup_cents or rights.studio_settled_cents > rights.studio_earned_cents: return false
+	var cutoff_net: int = int(rights.raw_net_cents) if rights.earning_cycles <= terms.recoup_cutoff_cycle else raw_at_age(sales,terms.recoup_cutoff_cycle)
+	if cutoff_net < 0 or cutoff_net > ProjectState.MAX_SIGNED_INT/int(terms.recoup_share_bp): return false
+	return rights.publisher_recoup_cents == mini(int(terms.support_budget_cents),cutoff_net*int(terms.recoup_share_bp)/10000)
+
+static func raw_at_age(sales: Dictionary, age: int) -> int:
+	if age < 0 or age > int(sales.get("total_earned_cycles",-1)): return -1
+	if age == 0: return 0
+	var prefix := sales.duplicate(true)
+	prefix.total_earned_cycles = age
+	var last_month: int = age/2+age%2
+	for month: Variant in prefix.market_factors.keys():
+		if month > last_month: prefix.market_factors.erase(month)
+	for month: Variant in prefix.campaign_months.keys():
+		if month > last_month: prefix.campaign_months.erase(month)
+	var expected := ReleasedGameSales._recalculate(prefix)
+	return int(expected.get("entitlement_cents",-1))
+
+static func units_at_age(sales: Dictionary, age: int) -> int:
+	if age < 0 or age > int(sales.get("total_earned_cycles",-1)): return -1
+	if age == 0: return 0
+	var prefix := sales.duplicate(true)
+	prefix.total_earned_cycles = age
+	var last_month: int = age/2+age%2
+	for month: Variant in prefix.market_factors.keys():
+		if month > last_month: prefix.market_factors.erase(month)
+	for month: Variant in prefix.campaign_months.keys():
+		if month > last_month: prefix.campaign_months.erase(month)
+	var expected := ReleasedGameSales._recalculate(prefix)
+	return int(expected.get("earned_units",-1))
+
+static func milestone(terms: Dictionary, review_tenths: int, actual_units: int) -> Dictionary:
+	if not valid_terms(terms) or review_tenths < 0 or review_tenths > 100 or actual_units < 0: return {}
+	var passed: bool = review_tenths >= terms.review_target_tenths and actual_units >= terms.month3_units_target
