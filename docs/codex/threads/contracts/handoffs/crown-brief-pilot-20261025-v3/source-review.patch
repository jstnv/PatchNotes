+		var focus := PublisherTrialTerms.focus(eligible) if kind==PublisherTrialTerms.NEON else -1
+		if c.trial_terms!=terms or c.neon_focus!=focus: return false
+		advance = terms.advance_cents
+		expected = PublisherTrialTerms.completion(kind,c.scope,c.cores,focus)
+	if expected.is_empty(): return false
+	var bonus_cash := 0
+	var bonus_promotion := 0
+	var grade_bp := 0
+	if c.has("challenge_terms"):
+		if kind==ContractState.CONTRACT_ID or c.challenge_terms != ContractChallenges.terms_for_contract(kind) or c.challenge_redraws>ContractChallenges.MAX_INPUT or (kind not in [ContractState.SIDESTREET_CONTRACT_ID,ContractDefinitions.SIDESTREET_BRIEF,ContractDefinitions.CROWN_BRIEF] and c.challenge_redraws!=0): return false
