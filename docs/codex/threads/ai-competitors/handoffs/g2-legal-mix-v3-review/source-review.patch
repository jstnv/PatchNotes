+static func _enumerate(sources: Array[CardData],start: int,current: Array[CardData],out: Array,limit: int) -> bool:
+	if current.size() == 4:
+		if out.size() >= limit: return false
+		out.append(current.duplicate())
+		return true
+	for index in range(start,sources.size()):
+		current.append(sources[index])
+		var ok := _enumerate(sources,index if sources[index].renewable else index+1,current,out,limit)
+		current.pop_back()
+		if not ok: return false
