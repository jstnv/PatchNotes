+			expect(player != null, "migrated player " + label)
+			if player == null: continue
+			var codec := Codec.new()
+			var world: RivalWorld = codec.restore(result.world,result.player,player,catalog)
+			expect(world != null, "migrated world " + label + " " + codec.error)
+			if world != null:
+				expect(world.cycle == 1 and not world.legacy.is_empty(), "Founder state " + label)
+				var saved_result := {"player":result.player,"world":result.world,"current_source_world_digest":Replay.digest(codec.capture(world))}
+				expect(write_json(migrated_path,saved_result), "isolated artifact " + label)
+		expect(FileAccess.get_sha256(original_path) == original_hash, "original bytes unchanged " + label)
