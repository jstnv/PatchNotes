@@ -0,0 +1,181 @@
+## Private old Founder-v1 and world-only migration proof.
+extends SceneTree
+
+const Migration := preload("res://scripts/market/market_save_migration_trial.gd")
+const Codec := preload("res://scripts/market/rival_world_checkpoint.gd")
+const Replay := preload("res://scripts/simulation/development_replay.gd")
+
+const CASES := [
+	{"label":"founder1","source":"0679720d9518de5ce8eb7f94ba7cd2970d001afad945b3a0e4156e5396de7040","cycle":1,"legacy":true},
+	{"label":"world1","source":"3e0d3958740f71149b3bb5b3e9f0b15b70cc6d71c96c6c03dd1f594d56a71c8f","cycle":9,"legacy":false},
+]
+var checks := 0
+var failures := 0
+var semantic_hashes := {}
+
+func expect(ok: bool, label: String) -> void:
+	checks += 1
+	if not ok:
+		failures += 1
+		push_error("MARKET_HISTORICAL " + label)
+
+func read_json(path: String) -> Variant:
+	if not FileAccess.file_exists(path): return null
+	return JSON.parse_string(FileAccess.get_file_as_string(path))
+
+func write_json(path: String, value: Dictionary) -> bool:
+	var file := FileAccess.open(path, FileAccess.WRITE)
+	if file == null: return false
+	file.store_string(JSON.stringify(value))
+	file.close()
+	return true
+
+func stripped_pair(player: Dictionary, world: Dictionary, old_revision: String) -> Dictionary:
+	var pair := {"player":player.duplicate(true),"world":world.duplicate(true)}
+	pair.world.erase("market")
+	var payloads: Array = [pair.player]
+	for row: Dictionary in pair.world.studios:
+		payloads.append(row.run)
+		if row.development != null:
+			row.development.project.erase("_market_standards")
+			row.development.project.erase("_market_snapshot_id")
+	for payload: Dictionary in payloads:
+		payload["content_revision"] = old_revision
+		for entry: Dictionary in payload.run.released_games:
+			entry.value.erase("market_factors")
+		for entry: Dictionary in payload.run.fanbase.releases:
+			entry.value.neutral.erase("market_factors")
+	return pair
+
+func check_historical_sales(player: RunState, world: RivalWorld, source: String, label: String) -> void:
+	var all_runs: Array = [player]
+	for session: Variant in world.studios.values(): all_runs.append(session.run)
+	var count := 0
+	for run: RunState in all_runs:
+		for id: StringName in run.get_released_game_ids():
+			count += 1
+			var sale: Dictionary = run.get_released_game_sales(id)
+			var earned_months: int = sale.total_earned_cycles/2 + sale.total_earned_cycles%2
+			expect(sale.market_factors.size() == earned_months, "earned age count " + label)
+			for age_month: int in sale.market_factors:
+				var factor: Dictionary = sale.market_factors[age_month]
+				expect(factor.factor_bp == 10000 and factor.snapshot_id == "pre-market-neutral:" + source, "old neutral factor " + label)
+	expect(count >= 3 if label == "world1" else count == 0, "real release count " + label)
+
+func _store_semantic_case(label: String, original: Dictionary, catalog: RefCounted, corrupt: bool, cold: bool, missing_card: bool = false) -> void:
+	var payload: Dictionary = original.player.duplicate(true)
+	payload["rival_world"] = original.world.duplicate(true)
+	if missing_card and label == "world1":
+		payload.rival_world.studios[0].development.hand.candidate_cards[0] = "__missing_market_card__"
+	elif corrupt and label == "world1":
+		payload.rival_world.history[0]["title"] = str(payload.rival_world.history[0].title) + " forged"
+	elif corrupt and label == "founder1":
+		payload.rival_world.legacy.founder["active_studio_id"] = "legacy-player"
+		payload.rival_world.legacy.founder.operated_periods[-1]["studio_id"] = "legacy-player"
+	var tag := label + ("-missing-card" if missing_card else "-altered" if corrupt else "-valid")
+	var directory := ProjectSettings.globalize_path("user://market-semantic-" + tag)
+	expect(DirAccess.make_dir_recursive_absolute(directory) == OK,"semantic Store directory " + tag)
+	var generation := int(original.player.sequence)
+	var path := directory.path_join("checkpoint.%d.json" % generation)
+	if not cold:
+		var envelope_codec := CheckpointCodec.new()
+		var envelope: String = envelope_codec.envelope(payload)
+		expect(envelope_codec.error.is_empty(),"semantic Store envelope " + tag)
+		var file := FileAccess.open(path,FileAccess.WRITE)
+		expect(file != null,"semantic Store file " + tag)
+		if file == null: return
+		file.store_string(envelope)
+		file.close()
+	expect(FileAccess.file_exists(path),"semantic Store persisted generation " + tag)
+	if not FileAccess.file_exists(path): return
+	var original_hash := FileAccess.get_sha256(path)
+	if cold:
+		expect(semantic_hashes.get(tag) == original_hash,"semantic cold input bytes " + tag)
+	else:
+		semantic_hashes[tag] = original_hash
+	var coordinator := CheckpointCoordinator.new()
+	root.add_child(coordinator)
+	coordinator.store = StudioCheckpointStore.new("user://market-semantic-" + tag,coordinator._validate_payload)
+	coordinator.rival_catalog = catalog
+	var inspected := coordinator.store.inspect()
+	expect(inspected.status == (&"invalid" if corrupt or missing_card else &"valid"),"semantic Store inspection " + tag + " actual=" + str(inspected.status))
+	var restored: RunState = coordinator.load_current()
+	expect((restored == null) if corrupt or missing_card else (restored != null and coordinator.rival_world != null),"semantic Continue " + tag)
+	expect(FileAccess.get_sha256(path) == original_hash and not FileAccess.file_exists(directory.path_join("checkpoint.%d.json" % (generation + 1))),"semantic input bytes/generation preserved " + tag)
+	coordinator.store.release_writer()
+	coordinator.queue_free()
+
+func _initialize() -> void:
+	await process_frame
+	var catalog: RefCounted = root.get_node("CardDatabase").get_development_catalog()
+	var cold: bool = FileAccess.file_exists("user://market-historical-ready.json")
+	if cold:
+		var saved_hashes: Variant = read_json("user://market-semantic-hashes.json")
+		expect(saved_hashes is Dictionary,"semantic cold hash manifest")
+		if saved_hashes is Dictionary: semantic_hashes = saved_hashes
+	var migration := Migration.new()
+	for definition: Dictionary in CASES:
+		var label: String = definition.label
+		var source: String = definition.source
+		var original_path: String = "user://market-%s-original.json" % label
+		var migrated_path: String = "user://market-%s-migrated.json" % label
+		var original: Variant = read_json(original_path)
+		expect(original is Dictionary, "old fixture " + label)
+		if not original is Dictionary: continue
+		expect(original.get("player") is Dictionary and original.get("world") is Dictionary, "old pair shape " + label)
+		if not original.get("player") is Dictionary or not original.get("world") is Dictionary: continue
+		var original_hash: String = FileAccess.get_sha256(original_path)
+		expect(original.world.get("source_identity") == source, "old source " + label)
+		expect(original.world.has("legacy") == definition.legacy, "old Founder shape " + label)
+		if cold:
+			var saved: Variant = read_json(migrated_path)
