+## Private preflight: decode raw old encoded shape and replay old sale/Fanbase math
+## before any market factor or revision is added. The three helpers are frozen
+## copies of the f8 pre-market source, with only class references relocated.
+extends RefCounted
+
+const OldSchema := preload("res://scripts/market/legacy_pre_market_schema.gd")
+const OldSales := preload("res://scripts/market/legacy_pre_market_sales.gd")
+const OldFanbase := preload("res://scripts/market/legacy_pre_market_fanbase.gd")
+
+func validate_payload(payload: Dictionary, expected_revision: String, active: bool = false) -> String:
+	if payload.size() != (9 if active else 8) or payload.get("checkpoint_kind") != ("rival_active" if active else "studio") or payload.get("content_revision") != expected_revision or payload.get("source_build") != StudioCheckpoint.BUILD or payload.get("rng_algorithm") != RunRandom.ALGORITHM:
+		return "Old Studio identity or field set mismatch"
+	var codec := CheckpointCodec.new()
+	var value: Variant = codec.decode(payload, OldSchema.root(true, active))
+	if not codec.error.is_empty() or not value is Dictionary:
+		return "Old Studio schema: " + codec.error
+	if value.sequence < 1 or value.run_id.is_empty() or value.run_id != value.run.bank_run_id:
+		return "Old Studio boundary mismatch"
+	var run: Dictionary = value.run
+	for id: StringName in run.released_games:
+		var sale: Dictionary = run.released_games[id]
+		if id.is_empty() or sale.release_id != id or not OldSales.is_valid(sale):
+			return "Old released sales accounting mismatch"
+	if not OldFanbase.validate(run.fanbase, run.released_games, run.release_metadata, run.completed_run_cycles, StudioTraits.starting_fans(run.studio_traits)):
+		return "Old Fanbase accounting mismatch"
+	return ""
