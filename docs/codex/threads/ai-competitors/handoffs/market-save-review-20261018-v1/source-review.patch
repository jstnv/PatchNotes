--- base/scripts/debug/verify_market_coordinator_integrated.gd
+++ candidate/scripts/debug/verify_market_coordinator_integrated.gd
@@ -0,0 +1,202 @@
+## Private normal Store/Coordinator migration proof for exact pre-market f8 source.
+## The original v18 direct verifier is retained as verify_market_migration_direct_v18.gd.
+extends SceneTree
+
+const Trial := preload("res://scripts/market/rival_trial.gd")
+const Migration := preload("res://scripts/market/market_save_migration_trial.gd")
+const WorldCodec := preload("res://scripts/market/rival_world_checkpoint.gd")
+const Replay := preload("res://scripts/simulation/development_replay.gd")
+
+class TestStore extends StudioCheckpointStore:
+	func acquire() -> bool:
+		var port := OS.get_environment("PN_CHECKPOINT_TEST_PORT")
+		if port.is_empty(): return false
+		if _writer != null: return true
+		var server := TCPServer.new()
+		if server.listen(int(port),"127.0.0.1") != OK: return false
+		_writer = server
+		return true
+
+var checks := 0
+var failures := 0
+var expected: Dictionary = {}
+
+func expect(ok: bool,label: String) -> void:
+	checks += 1
+	if ok: return
+	failures += 1
+	push_error("MARKET_COORDINATOR " + label)
+
+func _read(path: String) -> Variant:
+	if not FileAccess.file_exists(path): return null
+	return JSON.parse_string(FileAccess.get_file_as_string(path))
+
+func _write(path: String,value: Variant) -> bool:
+	var file := FileAccess.open(path,FileAccess.WRITE)
+	if file == null: return false
+	file.store_string(JSON.stringify(value,"\t"))
+	file.close()
+	return true
+
+func _fixture(cycle: int) -> Dictionary:
+	var path := "user://market-legacy-cycle-%d.json" % cycle
+	var value: Variant = _read(path)
+	if not value is Dictionary: return {}
+	return value
+
+func _store_path(tag: String) -> String:
+	return "user://market-coordinator-" + tag
+
+func _generation(tag: String,sequence: int) -> String:
+	return ProjectSettings.globalize_path(_store_path(tag)).path_join("checkpoint.%d.json" % sequence)
+
+func _seed_store(tag: String,payload: Dictionary) -> String:
+	var directory := ProjectSettings.globalize_path(_store_path(tag))
+	if DirAccess.make_dir_recursive_absolute(directory) != OK: return ""
+	var path := _generation(tag,1)
+	if FileAccess.file_exists(path): return ""
+	var codec := CheckpointCodec.new()
+	var envelope := codec.envelope(payload)
+	if not codec.error.is_empty(): return ""
+	var file := FileAccess.open(path,FileAccess.WRITE)
+	if file == null: return ""
+	file.store_string(envelope)
+	file.close()
+	return FileAccess.get_sha256(path)
+
+func _coordinator(tag: String,catalog: RefCounted) -> CheckpointCoordinator:
+	var node := CheckpointCoordinator.new()
+	root.add_child(node)
+	node.store = TestStore.new(_store_path(tag),node._validate_payload)
+	node.rival_catalog = catalog
+	return node
+
+func _captured_digest(node: CheckpointCoordinator) -> String:
+	var player := StudioCheckpoint.new().capture(node.run)
+	var world := WorldCodec.new().capture(node.rival_world)
+	if player.is_empty() or world.is_empty(): return ""
+	return Replay.digest({"player":player,"world":world})
+
+func _test_pair(cycle: int,tag: String,catalog: RefCounted,inject_failure: bool = false,corrupt_backup: bool = false) -> void:
+	var fixture := _fixture(cycle)
+	expect(not fixture.is_empty(),"old legal fixture " + tag)
+	if fixture.is_empty(): return
+	expect(fixture.source_identity == Migration.OldSource and fixture.world.source_identity == Migration.OldSource,"exact old source " + tag)
+	var old_hash: String = FileAccess.get_sha256(ProjectSettings.globalize_path("user://market-legacy-cycle-%d.json" % cycle))
+	var payload: Dictionary = fixture.player.duplicate(true)
+	payload["rival_world"] = fixture.world.duplicate(true)
+	var initial_hash := _seed_store(tag,payload)
+	expect(not initial_hash.is_empty(),"old generation constructed " + tag)
+	if initial_hash.is_empty(): return
+	var node := _coordinator(tag,catalog)
+	var inspected: Dictionary = node.store.inspect()
+	expect(inspected.status == &"valid" and inspected.sequence == 1,"Store validates named old generation " + tag)
+	var run: RunState = node.load_current()
+	expect(run != null and node.rival_world != null,"Coordinator Continue loads whole old pair " + tag)
+	if run == null or node.rival_world == null:
+		node.store.release_writer()
+		node.queue_free()
+		return
+	node.entered_studio(true)
+	var direct := Migration.new().upgrade_pair(fixture.player,fixture.world)
+	expect(not direct.is_empty() and node.rival_world.market_snapshot == direct.market,"Continue uses the exact v18 in-memory upgrade " + tag)
+	expect(node.store.inspect().sequence == 1 and FileAccess.get_sha256(_generation(tag,1)) == initial_hash,"Continue itself does not publish or rewrite old generation " + tag)
+	var before: Dictionary = fixture.duplicate(true)
+	var prior: int = node.rival_world.cycle
+	if inject_failure: node.store.fault = &"before_rename"
+	expect(run.complete_productive_action(Callable(),0,prior),"legal player productive cycle " + tag)
+	var report: Dictionary = node.rival_world.advance_committed_player_cycle(Trial.policies(node.rival_world),Trial.ZERO_STEPS)
+	expect(report.get("ok",false) and node.rival_world.cycle == prior+1,"legal rival world advance " + tag)
+	await process_frame
+	if inject_failure:
+		expect(not node.failure.is_empty() and node.store.inspect().sequence == 1,"interrupted publication retains old current " + tag)
+		expect(not run.complete_productive_action(Callable(),0,prior+1),"save failure blocks second action " + tag)
+		node.store.fault = &""
+		expect(node.retry(),"retry publishes once without replay " + tag)
+	else:
+		expect(node.flush(),"committed pair flush succeeds " + tag)
+	inspected = node.store.inspect()
+	expect(inspected.status == &"valid" and inspected.sequence == 2,"new atomic generation validates " + tag)
+	expect(FileAccess.get_sha256(_generation(tag,1)) == initial_hash,"original old generation bytes retained " + tag)
+	expect(Replay.digest(before) == Replay.digest(_fixture(cycle)) and FileAccess.get_sha256(ProjectSettings.globalize_path("user://market-legacy-cycle-%d.json" % cycle)) == old_hash,"source fixture remains byte and state identical " + tag)
+	if inspected.status == &"valid":
+		expect(inspected.payload.rival_world.has("market") and inspected.payload.rival_world.source_identity == Replay.source_identity(),"new generation captures current market source " + tag)
+		expect(int(inspected.payload.run.completed_run_cycles) == cycle+1,"exact post-Continue cycle persisted " + tag)
+		expected[tag] = {"sequence":2,"cycle":cycle+1,"digest":_captured_digest(node)}
+	if corrupt_backup and inspected.status == &"valid":
+		var current_path := _generation(tag,2)
+		var file := FileAccess.open(current_path,FileAccess.WRITE)
+		file.store_string("{broken")
+		file.close()
+		var corrupt_hash := FileAccess.get_sha256(current_path)
+		var invalid := node.store.inspect()
+		expect(invalid.status == &"invalid" and invalid.has("backup") and invalid.backup.sequence == 1,"corrupt current exposes old validated backup " + tag)
+		expect(node.load_current() == null,"normal Continue refuses corrupt current " + tag)
+		expect(node.store.save(inspected.payload).status == &"invalid","ordinary save refuses corrupt current " + tag)
+		var recovered := node.store.recover_backup()
+		expect(recovered.status == &"saved" and recovered.sequence == 3,"explicit recovery publishes fresh generation " + tag)
+		expect(FileAccess.get_sha256(current_path) == corrupt_hash and FileAccess.get_sha256(_generation(tag,1)) == initial_hash,"recovery preserves damaged and old bytes " + tag)
+		var recovered_run: RunState = node.load_current()
+		expect(recovered_run != null and node.rival_world != null and node.rival_world.cycle == cycle,"explicit backup restores earlier world without extra month " + tag)
+		if recovered_run != null and node.rival_world != null:
+			expected[tag] = {"sequence":3,"cycle":cycle,"digest":_captured_digest(node)}
+	node.store.release_writer()
+	node.queue_free()
+	await process_frame
+
+func _negative(catalog: RefCounted,tag: String,player: Dictionary,world: Dictionary) -> void:
+	var payload: Dictionary = player.duplicate(true)
+	payload["rival_world"] = world.duplicate(true)
+	var original_hash := _seed_store(tag,payload)
+	expect(not original_hash.is_empty(),"negative generation constructed " + tag)
+	if original_hash.is_empty(): return
+	var node := _coordinator(tag,catalog)
+	var result := node.store.inspect()
+	expect(result.status != &"valid" and node.load_current() == null,"invalid old pair rejects " + tag)
+	expect(FileAccess.get_sha256(_generation(tag,1)) == original_hash,"rejection preserves original bytes " + tag)
+	node.store.release_writer()
+	node.queue_free()
+	await process_frame
+
+func _cold(catalog: RefCounted) -> void:
+	var manifest: Variant = _read("user://market-coordinator-expected.json")
+	expect(manifest is Dictionary and manifest.size() == 5,"cold manifest covers all committed pairs")
+	if not manifest is Dictionary: return
+	for tag: String in manifest:
+		var node := _coordinator(tag,catalog)
+		var inspected := node.store.inspect()
+		expect(inspected.status == &"valid" and inspected.sequence == int(manifest[tag].sequence),"cold Store generation " + tag)
+		var run: RunState = node.load_current()
+		expect(run != null and node.rival_world != null,"fresh-process Coordinator Continue " + tag)
+		if run != null and node.rival_world != null:
+			expect(node.rival_world.cycle == int(manifest[tag].cycle),"cold world cycle " + tag)
+			expect(_captured_digest(node) == manifest[tag].digest,"cold full player/world recapture digest " + tag)
+		node.store.release_writer()
+		node.queue_free()
+		await process_frame
+
+func _initialize() -> void:
+	_run.call_deferred()
+
+func _run() -> void:
+	create_timer(180.0).timeout.connect(func() -> void: push_error("Market Coordinator timed out"); quit(2))
+	var catalog: RefCounted = root.get_node("CardDatabase").get_development_catalog()
+	if FileAccess.file_exists("user://market-coordinator-expected.json"):
+		await _cold(catalog)
+		print("MARKET_COORDINATOR_COLD checks=%d failures=%d" % [checks,failures])
+		quit(0 if failures == 0 else 1)
+		return
+	for cycle in [7,8,10]: await _test_pair(cycle,"cycle-%d" % cycle,catalog)
+	await _test_pair(10,"fault-10",catalog,true)
+	await _test_pair(10,"backup-10",catalog,false,true)
+	var bad := _fixture(10)
+	if not bad.is_empty():
+		var unknown: Dictionary = bad.world.duplicate(true)
+		unknown["source_identity"] = "unapproved-old-source"
+		await _negative(catalog,"unknown-source",bad.player,unknown)
+		var damaged: Dictionary = bad.world.duplicate(true)
+		damaged.studios[0].run.run.released_games[0].value.erase("total_earned_cycles")
+		await _negative(catalog,"missing-old-sale",bad.player,damaged)
+	expect(_write("user://market-coordinator-expected.json",expected),"cold manifest written")
+	print("MARKET_COORDINATOR checks=%d failures=%d" % [checks,failures])
+	quit(0 if failures == 0 else 1)
