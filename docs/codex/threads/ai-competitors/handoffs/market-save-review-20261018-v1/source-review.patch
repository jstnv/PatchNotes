+## Private design candidate. Snapshot commitment only; Review and sales
+## coefficients remain shadow outputs until the owner ledgers can save them.
+extends RefCounted
+
+const Index := preload("res://queries/market_release_index.gd")
+const WINDOW_CYCLES := 12
+const VERSION := 1
+
+static func neutral() -> Dictionary:
+	return {"version":VERSION,"cycle_start":0,"id":"market-0-neutral","facts":[]}
+
+static func identifier(cycle_start: int, facts: Array) -> String:
+	var ordered: Array=[]
+	for row: Dictionary in facts:
+		ordered.append([row.studio_id,row.release_id,row.release_cycle,row.genre,row.theme,
+			row.review_tenths,row.cores_available,row.cores])
+	return "market-%d-%s"%[cycle_start,JSON.stringify(ordered).sha256_text()]
+
+static func valid(snapshot: Variant) -> bool:
+	if not snapshot is Dictionary or snapshot.size()!=4 or snapshot.get("version")!=VERSION or not snapshot.get("cycle_start") is int or not snapshot.get("id") is String or not snapshot.get("facts") is Array:
+		return false
+	if snapshot.cycle_start<0 or snapshot.cycle_start%2!=0 or snapshot.id.is_empty(): return false
+	var prior := ""
+	for row: Variant in snapshot.facts:
+		if not row is Dictionary or row.size()!=8: return false
+		for key: String in ["studio_id","release_id","genre","theme"]:
+			if not row.get(key) is String or row[key].is_empty(): return false
+		for key: String in ["release_cycle","review_tenths"]:
