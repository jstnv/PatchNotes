+		if first is Dictionary:
+			var bad: Dictionary = first.world.duplicate(true)
+			bad["source_identity"] = "unknown-source"
+			expect(migration.upgrade_pair(first.player,bad).is_empty(), "unknown source rejects")
+		if failures == 0:
+			expect(write_json("user://market-source-family-ready.json",{"ready":true}),"cold marker")
