+## Private named-source Founder v2 migration probe; no canonical integration.
+extends SceneTree
+
+const Migration := preload("res://scripts/market/market_save_migration_trial.gd")
+const Codec := preload("res://scripts/market/rival_world_checkpoint.gd")
+const Replay := preload("res://scripts/simulation/development_replay.gd")
+
+var checks := 0
+var failures := 0
+
+func expect(ok: bool, label: String) -> void:
+	checks += 1
+	if not ok:
+		failures += 1
+		push_error("MARKET_FOUNDER_F8 " + label)
+
+func read_json(path: String) -> Variant:
+	if not FileAccess.file_exists(path): return null
+	return JSON.parse_string(FileAccess.get_file_as_string(path))
+
+func write_json(path: String, value: Dictionary) -> bool:
+	var file := FileAccess.open(path, FileAccess.WRITE)
+	if file == null: return false
+	file.store_string(JSON.stringify(value))
+	file.close()
+	return true
+
+func strip_new_fields(player: Dictionary, world: Dictionary) -> Dictionary:
+	var pair := {"player":player.duplicate(true),"world":world.duplicate(true)}
+	pair.world.erase("market")
+	var payloads: Array = [pair.player]
+	for row: Dictionary in pair.world.studios:
+		payloads.append(row.run)
+		if row.development != null:
+			row.development.project.erase("_market_standards")
+			row.development.project.erase("_market_snapshot_id")
+	for payload: Dictionary in payloads:
+		for entry: Dictionary in payload.run.released_games:
+			entry.value.erase("market_factors")
+		for entry: Dictionary in payload.run.fanbase.releases:
+			entry.value.neutral.erase("market_factors")
+	return pair
+
+func _initialize() -> void:
+	await process_frame
+	var catalog: RefCounted = root.get_node("CardDatabase").get_development_catalog()
+	var original: Variant = read_json("user://founder-f8-original.json")
+	expect(original is Dictionary, "old fixture present")
+	if not original is Dictionary: quit(1); return
+	expect(original.get("player") is Dictionary and original.get("world") is Dictionary, "pair shape")
+	if not original.get("player") is Dictionary or not original.get("world") is Dictionary: quit(1); return
+	var old_hash := FileAccess.get_sha256("user://founder-f8-original.json")
+	expect(original.world.get("source_identity") == Migration.OldSource, "exact f8 source")
+	expect(original.world.has("legacy") and original.world.legacy.get("version") == "2", "Founder v2 source")
+	var saved: Variant = read_json("user://founder-f8-migrated.json")
+	if saved is Dictionary:
+		var player := StudioCheckpoint.new().hydrate(saved.player)
+		expect(player != null, "cold player")
+		if player != null:
+			var codec := Codec.new()
+			var world: RivalWorld = codec.restore(saved.world, saved.player, player, catalog)
+			expect(world != null, "cold Founder world " + codec.error)
+			if world != null:
+				expect(world.cycle == 1 and not world.legacy.is_empty(), "cold Founder state")
+				expect(Replay.digest(codec.capture(world)) == saved.current_source_world_digest, "cold recapture digest")
+		expect(FileAccess.get_sha256("user://founder-f8-original.json") == old_hash, "original file unchanged cold")
+		print("MARKET_FOUNDER_F8_COLD checks=%d failures=%d" % [checks, failures])
+		quit(0 if failures == 0 else 1)
+		return
+	var migration := Migration.new()
+	var result: Dictionary = migration.upgrade_pair(original.player, original.world)
+	expect(not result.is_empty(), "upgrade Founder pair " + migration.error)
+	if result.is_empty():
+		print("MARKET_FOUNDER_F8 checks=%d failures=%d" % [checks, failures])
+		quit(1)
+		return
+	var stripped := strip_new_fields(result.player, result.world)
+	expect(stripped.player == original.player and stripped.world == original.world, "all old fields equal")
+	expect(result.world.source_identity == Migration.OldSource, "old source retained")
+	expect(result.world.legacy == original.world.legacy, "Founder ledger exact")
+	expect(result.market.cycle_start == 0 and result.market.facts.is_empty(), "January snapshot excludes new releases")
+	var player := StudioCheckpoint.new().hydrate(result.player)
+	expect(player != null, "migrated player hydrate")
+	if player != null:
+		var codec := Codec.new()
+		var world: RivalWorld = codec.restore(result.world, result.player, player, catalog)
+		expect(world != null, "migrated Founder world restore " + codec.error)
+		if world != null:
+			expect(world.cycle == 1 and not world.legacy.is_empty(), "Founder state intact")
+			var persisted := {"player":result.player,"world":result.world,"current_source_world_digest":Replay.digest(codec.capture(world))}
+			expect(write_json("user://founder-f8-migrated.json", persisted), "write isolated migrated artifact")
+	var bad: Dictionary = original.world.duplicate(true)
+	bad["source_identity"] = "unknown-source"
+	expect(migration.upgrade_pair(original.player, bad).is_empty(), "unknown source rejects")
+	expect(FileAccess.get_sha256("user://founder-f8-original.json") == old_hash, "original file unchanged")
+	print("MARKET_FOUNDER_F8 checks=%d failures=%d" % [checks, failures])
+	quit(0 if failures == 0 else 1)
--- base/scripts/debug/verify_market_historical_sources.gd
