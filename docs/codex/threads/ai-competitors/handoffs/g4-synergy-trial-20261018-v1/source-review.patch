+## Private matched policy wrapper; reference repeats the unchanged trial choice.
+extends RefCounted
+
+const POLICY_ID := "g4-synergy-choice-study"
+const POLICY_VERSION := "1"
+const Fixture := preload("res://scripts/simulation/finite_fixture_policy.gd")
+const Trial := preload("res://scripts/market/rival_trial.gd")
+
+static func factory(config: Dictionary) -> Callable:
+	if not Fixture.valid_config(config) or config.get("mode") not in ["reference", "synergy", "synergy_beta"]: return Callable()
+	if config.get("selection") != "features_first" or config.get("theme") != "fantasy": return Callable()
+	for phase in ["design", "alpha", "beta"]:
+		if float(config.hands.get(phase, -1)) != 2.0: return Callable()
+	var mode := str(config.mode)
+	var genre := str(config.genre)
+	var label := str(config.name_prefix)
+	if mode in ["synergy", "synergy_beta"]:
+		var beta_aware := mode == "synergy_beta"
+		return func(view: Dictionary) -> Dictionary: return Trial.choose(view,genre,label,beta_aware)
+	return func(view: Dictionary) -> Dictionary: return _reference_choice(view,genre,label)
+
+static func _reference_choice(view: Dictionary, genre: String, label: String) -> Dictionary:
+	if view.phase == &"studio":
+		return {"type":&"begin_development","payload":{"name":"%s %d" % [label,view.releases.size()+1],"genre":genre,"theme":"fantasy"}}
+	if view.phase == &"contract": return {}
+	var current: Dictionary = view.development
+	if current.finalized: return {"type":&"launch"} if current.phase == "beta" else _development(view,&"enter_next_phase")
+	if current.confirmation_pending: return _development(view,&"confirm_exit")
+	if not current.active: return _development(view,&"begin")
+	if current.get("hand_revision",0) >= 3 and current.get("can_exit",false): return _development(view,&"request_exit")
+	var cards: Array = current.candidates.duplicate(true)
+	cards.sort_custom(func(a: Dictionary,b: Dictionary) -> bool:
+		if (a.type == "feature") != (b.type == "feature"): return a.type == "feature"
+		return int(a.token) < int(b.token))
+	if cards.size()<4: return {}
+	var tokens: Array[int] = []
+	for index in range(4): tokens.append(int(cards[index].token))
+	return _development(view,&"play",{"candidate_ids":tokens})
+
+static func _development(view: Dictionary,kind: StringName,payload: Dictionary = {}) -> Dictionary:
+	var current: Dictionary = view.development
+	return {"type":&"development","payload":{"request":{"schema_version":1,"type":kind,"project_id":view.project_id,"phase":current.phase,"sequence":current.sequence,"project_cycle":current.project_cycle,"run_cycle":current.run_cycle,"payload":payload}}}
