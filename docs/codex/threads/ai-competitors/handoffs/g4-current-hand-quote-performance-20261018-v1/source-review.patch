+## Private G4 study only: read the existing exact Feature price and productive
+## cycle preflight for every current four-card choice. The preflight is a cash
+## and next-cycle quote; it cannot promise the hand's production/refill succeeds.
+func _trial_current_hand_quotes() -> Array:
+	var quotes: Array = []
+	if phase_index >= 2 or not hand.active or finalized or awaiting_confirmation:
+		return quotes
+	var count: int = hand.candidate_ids.size()
+	if count != 7 or hand._candidate_cards.size() != count:
+		return quotes
+	var combinations: Array = []
+	var distinct_costs: Array[int] = []
+	var seen_costs: Dictionary = {}
+	for a in range(count - 3):
+		for b in range(a + 1, count - 2):
+			for c in range(b + 1, count - 1):
+				for d in range(c + 1, count):
+					var ids: Array = [hand.candidate_ids[a], hand.candidate_ids[b], hand.candidate_ids[c], hand.candidate_ids[d]]
+					var cards: Array[CardData] = [hand._candidate_cards[a], hand._candidate_cards[b], hand._candidate_cards[c], hand._candidate_cards[d]]
+					var cost: int = run.primitive_feature_hand_cost_cents(cards, project.get_release_id())
+					combinations.append({"candidate_ids": ids, "cost_cents": cost})
+					if cost >= 0 and not seen_costs.has(cost):
+						seen_costs[cost] = true
+						distinct_costs.append(cost)
+	var planned_by_cost: Dictionary = {}
+	if project.can_advance_cycle():
+		planned_by_cost = run._plan_feature_play_costs(distinct_costs, project.get_release_id())
+	for choice: Dictionary in combinations:
+		var cost: int = choice.cost_cents
+		var planned: Dictionary = planned_by_cost.get(cost, {})
+		var available: bool = not planned.is_empty()
+		var finance: Dictionary = planned.get("finance", {})
+		quotes.append({"candidate_ids": choice.candidate_ids, "cost_cents": cost,
+			"cash_preflight_ok": available,
+			"next_cash_cents": int(finance.get("cash_cents", -1)) if available and not finance.is_empty() else -1,
+			"settlement_cents": int(planned.get("payable", -1)) if available else -1,
+			"bills_paid_cents": int(finance.get("bills_paid_cents", -1)) if available and not finance.is_empty() else -1})
+	return quotes
