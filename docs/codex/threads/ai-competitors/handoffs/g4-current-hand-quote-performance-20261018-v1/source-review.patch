+## Exact current-cycle Feature cash preflights for several prices. Each distinct
+## price still receives its own finance plan because it may change bill service.
+func _plan_feature_play_costs(costs: Array[int], source_id: StringName) -> Dictionary:
+	var plans: Dictionary = {}
+	if _productive_cycle_in_progress or _feature_purchase_in_progress or _pending_contract_completion != null or _completed_run_cycles < 0 or _completed_run_cycles == MAX_SIGNED_INT or _available_redraws < 0 or _available_redraws > MAX_REDRAWS:
+		return plans
+	var eligible: Array[int] = []
+	for cost: int in costs:
+		if plans.has(cost): continue
+		plans[cost] = {}
+		if cost < 0 or cost > _cash_cents or (cost != 0 and not _cash_initialized): continue
+		eligible.append(cost)
+	if eligible.is_empty(): return plans
+	var shared: Dictionary = _plan_productive_cycle_shared(&"")
+	if shared.is_empty(): return plans
+	for cost: int in eligible:
+		plans[cost] = _plan_productive_cycle_after_shared(-cost, &"", &"feature_play", source_id, shared)
+	return plans
 
 
