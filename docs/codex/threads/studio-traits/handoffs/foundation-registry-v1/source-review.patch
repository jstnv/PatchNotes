--- base/scripts/debug/trait_foundation_snapshot_v1.gd
+++ candidate/scripts/debug/trait_foundation_snapshot_v1.gd
@@ -0,0 +1,39 @@
+## Read-only cross-version contract snapshot; run against baseline and candidate projects.
+extends SceneTree
+
+func _initialize() -> void:
+	var args := OS.get_cmdline_user_args()
+	if args.size() != 1:
+		push_error("Expected one absolute output path")
+		quit(2)
+		return
+	var ids: Array = StudioTraits.TRAITS.keys()
+	var results: Array = []
+	for version in range(3, 9):
+		for mask in range(1 << ids.size()):
+			var chosen: Array = []
+			var positive := 0
+			var negative := 0
+			for index in ids.size():
+				if mask & (1 << index):
+					var id: StringName = ids[index]
+					chosen.append(id)
+					if StudioTraits.TRAITS[id].positive: positive += 1
+					else: negative += 1
+			if positive > 2 or negative > 1: continue
+			var selection := StudioTraits.evaluate_traits(chosen, version)
+			results.append({"version":version, "chosen":chosen, "selection":selection,
+				"summary":StudioTraits.summary(selection), "starting_fans":StudioTraits.starting_fans(selection),
+				"first_awareness":StudioTraits.launch_awareness(selection,100,true),
+				"later_awareness":StudioTraits.launch_awareness(selection,100,false)})
+	for invalid: Array in [[&"family_funding",&"family_funding"],[&"family_funding",&"cult_following",&"studio_buzz"],[&"college_dropout",&"unknown_name"],[&"student_loan"],[null]]:
+		results.append({"invalid":invalid,"selection":StudioTraits.evaluate_traits(invalid)})
+	var file := FileAccess.open(args[0], FileAccess.WRITE)
+	if file == null:
+		push_error("Could not write snapshot")
+		quit(3)
+		return
+	file.store_string(JSON.stringify({"contract":"studio_trait_selection_versions_3_to_8_v1", "results":results},"\t"))
+	file.close()
+	print("Trait foundation snapshot: ",results.size()," cases")
+	quit()
