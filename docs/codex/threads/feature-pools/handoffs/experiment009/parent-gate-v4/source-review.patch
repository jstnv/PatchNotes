+## Experiment 009 private mechanics fixtures. Not a canonical verification suite.
+extends SceneTree
+
+var failures := 0
+var passes := 0
+
+func _initialize() -> void:
+	call_deferred("_verify")
+
+func check(ok: bool, label: String) -> void:
+	if ok:
+		passes += 1
+		print("PASS: " + label)
+	else:
+		failures += 1
+		push_error("FAIL: " + label)
+
+func _verify() -> void:
+	var locked := RunState.new()
+	locked.initialize_cash_cents(500000)
+	_inject_test_parent(locked)
+	locked._owned_features.erase(&"8_bit_music")
+	var blocked := locked.get_feature_store_offer(&"recorded_sounds")
+	check(not blocked.unlocked and blocked.missing_parents == ["8-Bit Music"] and blocked.parents.size() == 2, "Second parent is a visible AND gate")
+	var blocked_quote := locked.get_feature_research_quote(&"recorded_sounds")
+	check(not blocked_quote.can_admit and not locked.admit_feature_research(blocked_quote) and locked.get_cash_cents() == 500000 and locked.get_completed_run_cycles() == 0, "Missing parent rejects admission without mutation")
+	locked._feature_research.append({"id":&"test:music","feature_id":&"8_bit_music","base_cents":45000,"actions":1,"admitted_cycle":0,"payments":[]})
+	check(not locked.get_feature_store_offer(&"recorded_sounds").unlocked, "Queued parent remains unowned")
+	locked._owned_features[&"8_bit_music"] = true
+	check(locked.get_feature_store_offer(&"recorded_sounds").unlocked, "Both owned parents unlock child")
+
+	var poor := RunState.new()
+	poor.initialize_cash_cents(84999)
+	_inject_test_parent(poor)
+	var poor_quote := poor.get_feature_research_quote(&"recorded_sounds")
+	check(poor_quote.down_cents == 85000 and not poor_quote.can_admit and not poor.admit_feature_research(poor_quote), "One-cent-short down payment rejects")
+	check(poor.get_cash_cents() == 84999 and poor.get_feature_research_queue().is_empty(), "Rejected down payment preserves cash and queue")
+
+	var run := RunState.new()
+	run.initialize_cash_cents(500000)
+	_inject_test_parent(run)
+	var before := run.get_feature_research_quote(&"recorded_sounds")
+	check(before.unlocked and before.down_cents == 85000 and before.due_cents == 85000 and before.discount_percent == 0, "Both owned with zero credits uses half-base payments")
+	check(run.admit_feature_research(before) and run.get_cash_cents() == 415000 and run.get_completed_run_cycles() == 0, "Admission charges base-half and no cycle")
+	var project := ProjectState.new(30)
+	check(run.record_resolved_feature(project,&"8_bit_sound",&"design") and run.record_resolved_feature(project,&"8_bit_music",&"design"), "Both named parents earn credits in one project")
+	check(not run.record_resolved_feature(project,&"8_bit_sound",&"design") and run.get_feature_familiarity(&"8_bit_sound") == 1, "Same parent cannot earn twice in one project")
+	var later := run.get_feature_research_quote(&"recorded_sounds")
+	check(later.discount_percent == 20 and later.down_cents == 85000 and later.due_cents == 68000 and later.paid_cents == 85000, "Mid-research credits discount only the unpaid installment")
+	check(run.research_feature(later) and run.owns_feature(&"recorded_sounds") and run.get_cash_cents() == 347000 and run.get_completed_run_cycles() == 1, "One successful research action pays discounted due and grants ownership")
+	for index in range(3):
+		var another := ProjectState.new(30)
+		run.record_resolved_feature(another,&"8_bit_sound",&"design")
+		run.record_resolved_feature(another,&"8_bit_music",&"design")
+	check(run.get_feature_familiarity(&"8_bit_sound") == 4 and run.get_feature_familiarity(&"8_bit_music") == 4 and run.get_feature_store_offer(&"recorded_sounds").discount_percent == 50, "Eight total parent credits retain history but share one 50% cap")
+	check(not run.record_resolved_feature(ProjectState.new(30),&"8_bit_music",&"contract"), "Contract use grants no parent credit")
+
+	var single := RunState.new()
+	single.initialize_cash_cents(500000)
+	check(single.get_feature_store_offer(&"colored_text").price_cents == 65000 and single.get_feature_store_offer(&"difficulty_levels").discount_percent == 0, "Current single-parent and Gameplay count quotes retain baseline")
+	single.record_resolved_feature(ProjectState.new(30),&"text",&"design")
+	check(single.get_feature_store_offer(&"colored_text").price_cents == 58500 and single.get_feature_research_quote(&"colored_text").down_cents == 32500 and single.get_feature_research_quote(&"colored_text").due_cents == 29250, "Single-parent familiarity still discounts only its installment")
+
+	var graph := RunState.new()
+	graph.initialize_cash_cents(0)
+	check(graph.create_studio_with_traits("Graph Fixture",&"action",[]), "Acquisition-path fixture starts as a legal Action Studio")
+	_add_node(graph,&"test_p1",[&"text"])
+	_add_node(graph,&"test_p2",[&"text"])
+	_add_node(graph,&"test_child",[&"test_p1",&"test_p2"])
+	var path := graph.get_feature_acquisition_quote(&"test_child")
+	var ids: Array = path.steps.map(func(step: Dictionary) -> StringName: return step.id)
+	check(path.available and ids == [&"text",&"test_p1",&"test_p2",&"test_child"], "Converged parent path counts shared ancestor once")
+	_add_node(graph,&"test_bad",[&"text",&"text"])
+	check(graph.get_feature_store_offer(&"test_bad").is_empty(), "Duplicate named parent rejects quote")
+	_add_node(graph,&"test_missing",[&"unknown_parent"])
+	check(graph.get_feature_store_offer(&"test_missing").is_empty(), "Unknown named parent rejects quote")
+	_add_node(graph,&"test_cycle_a",[&"test_cycle_b"])
+	_add_node(graph,&"test_cycle_b",[&"test_cycle_a"])
+	check(not graph.get_feature_acquisition_quote(&"test_cycle_a").available, "Cycle rejects acquisition path")
+
+	print("Two-parent prototype: %d passes, %d failures" % [passes,failures])
+	quit(failures)
+
+func _add_node(run: RunState,id: StringName,parents: Array[StringName]) -> void:
+	var entry := {"id":str(id),"name":str(id),"type":"feature","phase":"design","department":"", "purchase_parent":str(parents[0]),"purchase_parents":parents.map(func(value: StringName) -> String: return str(value)),"gameplay_features_required":0,"base_price_cents":65000}
+	run._feature_definitions[id] = entry
+	run._feature_offers[id] = entry
+
+func _inject_test_parent(run: RunState) -> void:
+	var entry: Dictionary = run._feature_offers[&"recorded_sounds"].duplicate(true)
+	entry["purchase_parents"] = ["8_bit_sound","8_bit_music"]
+	run._feature_definitions[&"recorded_sounds"] = entry
+	run._feature_offers[&"recorded_sounds"] = entry
