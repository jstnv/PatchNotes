+	run_state=rival_world.player
+	project_state=null
+	_review_rng=run_state.random_streams.stream(&"review")
+	checkpoints.attach(run_state)
+	checkpoints.attach_rivals(rival_world,checkpoints.rival_catalog)
+	_connect_rival_calendar()
