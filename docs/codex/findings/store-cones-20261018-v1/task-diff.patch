+++ after/scripts/debug/capture_store_cones.gd
@@ -0,0 +1,76 @@
+extends "res://scripts/debug/capture_primitive_branches.gd"
+
+func _verify_category_layout(store: FeatureStore) -> void:
+	super._verify_category_layout(store)
+	var map := store._map
+	var graph := FeatureStoreCatalog.graph(store._run._feature_definitions, store._run._feature_offers)
+	var positions := {}
+	for lane: StringName in store.LANE_ORDER:
+		var roots: Array = []
+		for id: StringName in store.LANE_MEMBERS[lane]:
+			if graph.parents[id].is_empty() and id != &"difficulty_levels": roots.append(id)
+		var direction: Vector2 = map.CATEGORY_DIRECTIONS[lane]
+		var anchor: Vector2 = store._nodes[roots[0]].position
+		var aligned := true
+		var grid := true
+		var outward := true
+		for id: StringName in store.LANE_MEMBERS[lane]:
+			var delta: Vector2 = store._nodes[id].position - anchor
+			positions[id] = [store._nodes[id].position.x, store._nodes[id].position.y]
+			grid = grid and is_zero_approx(fposmod(absf(delta.x), map.BRANCH_STEP)) and is_zero_approx(fposmod(absf(delta.y), map.ROW_STEP))
+			if roots.has(id): aligned = aligned and is_zero_approx(delta.dot(direction))
+			else: outward = outward and delta.dot(direction) > 0.0
+		expect(aligned and grid and outward, "inner root axis, cardinal grid and no root in front of branches: " + str(lane))
+		var cone: PackedVector2Array = map.category_cones[lane]
+		expect(cone.size() >= 5, "outward cone polygon " + str(lane))
+		if lane == &"Visuals": expect(roots == [&"text", &"4_color_palette"], "Visuals has exactly the two approved roots")
+		if lane == &"Audio": expect(roots == [&"sound_effects", &"music"], "Audio has exactly the two approved roots")
+	var children := {}
+	for edge: Array in store._edges:
+		if not children.has(edge[0]): children[edge[0]] = []
+		children[edge[0]].append(edge[1])
+	for parent: StringName in children:
+		if children[parent].size() < 2: continue
+		var descendants: Array = map._children(parent, children)
+		var lane: StringName = store._lane_by_id[parent]
+		var across: Vector2 = map._across(lane)
+		var first: Vector2 = store._nodes[descendants[0]].position
+		var source: Vector2 = store._nodes[parent].position
+		var sibling: Vector2 = store._nodes[descendants[1]].position
+		expect(is_zero_approx((first-source).dot(across)) and sibling-first == across, "every fork has aligned first child and adjacent sibling: " + str(parent))
+	var combat: Vector2 = store._nodes[&"general_combat"].position
+	var turn: Vector2 = store._nodes[&"turn_based_combat"].position
+	var classes: Vector2 = store._nodes[&"character_classes"].position
+	expect(turn.y == combat.y and turn.x < combat.x and classes.x == turn.x and classes.y == turn.y + map.ROW_STEP, "Combat continues straight to Turn-Based with Classes in adjacent row below")
+	var middle: Vector2 = map.center
+	for lane: StringName in store.LANE_ORDER:
+		var region: Rect2 = map.category_regions[lane]
+		if lane in [&"Gameplay", &"Story & World"]: expect(region.position.y > middle.y, "lower cone " + str(lane))
+		else: expect(region.end.y < middle.y, "upper cone " + str(lane))
+	var folder := OS.get_environment("PN_STORE_CAPTURE")
+	if not folder.is_empty(): FileAccess.open(folder.path_join("positions.json"), FileAccess.WRITE).store_string(JSON.stringify(positions,"\t"))
+
+func _capture(label: String, width: int) -> void:
+	var folder := OS.get_environment("PN_STORE_CAPTURE")
+	if folder.is_empty(): return
+	await create_timer(0.15).timeout
+	await RenderingServer.frame_post_draw
+	var picture := root.get_texture().get_image()
+	expect(picture.get_width() == width, "native capture width")
+	picture.save_png(folder.path_join("store-%s-%d.png" % [label,width]))
+	if label != "overview": return
+	var map := active_store._map
+	for lane: StringName in active_store.LANE_ORDER:
+		var area: Rect2 = map.category_regions[lane]
+		var view: Vector2 = map._map_rect().size - Vector2(24,24)
+		map.set_zoom(minf(view.x / area.size.x, view.y / area.size.y))
+		map.center_after_layout(area.get_center(), map._view_revision)
+		await create_timer(0.2).timeout
+		await _capture(str(lane).replace(" & ","-").to_lower(), width)
+	# Show the requested fork at readable scale, without the detail popup.
+	map.set_zoom(minf(0.8, (map._map_rect().size.y - 24.0) / (map.ROW_STEP + 172.0)))
+	map.center_after_layout(active_store._nodes[&"turn_based_combat"].position + Vector2((map.SIDE_BRANCH_STEP + 128.0) / 2.0, (map.ROW_STEP + 172.0) / 2.0), map._view_revision)
+	await create_timer(0.2).timeout
+	await _capture("combat-fork", width)
+	map.fit_map()
+	await create_timer(0.2).timeout
--- before/scripts/debug/verify_store_cone_parents.gd
+++ after/scripts/debug/verify_store_cone_parents.gd
@@ -0,0 +1,71 @@
+extends "res://scripts/debug/verify_primitive_branches.gd"
+
+const CHANGES := {
+	&"multiple_endings": &"branching_dialogue", &"secrets": &"exploration",
+	&"8_bit_music": &"music", &"8_bit_sound": &"sound_effects",
+	&"scrolling": &"text", &"sprites": &"4_color_palette",
+}
+
+func _initialize() -> void:
+	await process_frame
+	catalog = root.get_node("CardDatabase").get_development_catalog()
+	var codec := StudioCheckpoint.new()
+	for child: StringName in CHANGES:
+		var parent: StringName = CHANGES[child]
+		for initial in [true,false]:
+			var run: RunState = fresh().run
+			# Controlled absent ownership / cash fixture to exercise the full chain.
+			run.add_cash_cents(2000000, &"other_income", &"cone-fixture")
+			var graph := FeatureStoreCatalog.graph(run._feature_definitions, run._feature_offers)
+			check(graph.parents[child] == [parent], "exact approved parent " + str(child))
+			var chain: Array = FeatureStoreCatalog.ordered_ancestors([child], graph.parents).order
+			for id: StringName in chain: run._owned_features.erase(id)
+			if not initial: run.finalize_starter_selection()
+			var before := state(run)
+			check(not run.get_primitive_reserve_offer(child).unlocked, "missing parent quote")
+			check(not run.purchase_starter_feature(child) and not run.admit_feature_research(run.get_feature_research_quote(child)) and state(run) == before, "missing-parent rejection is atomic")
+			var acquisition := run.get_feature_acquisition_quote(child)
+			var ids: Array = []
+			for row: Dictionary in acquisition.steps: ids.append(row.id)
+			check(ids == chain, "exact ordered transitive acquisition chain " + str(child))
+			if initial and child == &"multiple_endings":
+				check(not run.purchase_starter_feature(parent), "later Branching Dialogue is not an initial Primitive buy")
+				run.finalize_starter_selection()
+			for id: StringName in chain:
+				if run.needs_starter_selection():
+					var cycle := run.get_completed_run_cycles()
+					check(run.purchase_starter_feature(id) and run.get_completed_run_cycles() == cycle, "zero-cycle Primitive purchase " + str(id))
+				else:
+					var quote := run.get_feature_research_quote(id)
+					check(quote.can_admit and run.admit_feature_research(quote), "legal ordered admission " + str(id))
+					check(not run.owns_feature(id), "deposit does not grant ownership")
+					if id == parent:
+						before = state(run)
+						check(not run.get_feature_research_quote(child).can_admit and not run.admit_feature_research(run.get_feature_research_quote(child)) and state(run) == before, "queued parent is not ownership")
+					var restored := codec.hydrate(codec.capture(run))
+					check(restored != null and codec.capture(restored) == codec.capture(run), "exact current queue hydration")
+					check(run.research_feature(run.get_feature_research_quote(id)), "complete one-action research " + str(id))
+			check(run.owns_feature(child), "chain ends in real child ownership " + str(child))
+	var path := OS.get_environment("PN_CONE_PRIOR_SAVES")
+	if not path.is_empty():
+		var prior: Dictionary = JSON.parse_string(FileAccess.get_file_as_string(path))
+		for key: String in prior:
+			var restored := codec.hydrate(prior[key])
+			check(restored != null, "actual pre-change checkpoint restores " + key + ": " + codec.error)
+			if restored == null: continue
+			var expected: Dictionary = prior[key].duplicate(true)
+			expected.content_revision = codec.revision()
+			check(codec.capture(restored) == expected, "only content marker changes " + key)
+			if key.begins_with("roster_"):
+				check(restored.get_owned_feature_ids() == fresh(StringName(key.trim_prefix("roster_"))).run.get_owned_feature_ids(), "unchanged fresh/legacy specialty roster " + key)
+			else:
+				var child := StringName(key)
+				check(not restored.owns_feature(CHANGES[child]), "old paid queue truly lacks new parent")
+				var q := restored.get_feature_research_quote(child)
+				var cash := restored.get_cash_cents()
+				var cycles := restored.get_completed_run_cycles()
+				check(restored.research_feature(q) and restored.owns_feature(child) and restored.get_cash_cents() == cash - q.due_cents and restored.get_completed_run_cycles() == cycles + 1, "grandfather queue, original unpaid balance and exactly one productive cycle " + key)
+				var before := state(restored)
+				check(not restored.research_feature(q) and state(restored) == before, "duplicate completion rejects")
+	print("STORE_CONE_PARENTS checks=%d failures=%d" % [checks,failures])
+	quit(failures)
